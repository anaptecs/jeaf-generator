            <nestedClassifier xmi:type="uml:Class" xmi:id="b80d2103-bf7e-4b8e-8ab1-566c521e9b18" name="Entry" visibility="private">
              <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="7e15232d-28d5-4068-9046-1780b1845696" name="" parameter="20b0f3df-345a-46a2-b030-d930741c9046">
                <ownedParameter xmi:type="uml:ClassifierTemplateParameter" xmi:id="20b0f3df-345a-46a2-b030-d930741c9046" parameteredElement="214e639e-a0da-45cf-866b-96ebe6e59a0d">
