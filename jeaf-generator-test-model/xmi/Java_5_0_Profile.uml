              <packagedElement xmi:type="uml:Class" xmi:id="fac8db90-8b58-4cc9-a841-86fd7afe34d8" name="AtomicIntegerArray" clientDependency="d4d27d2b-894c-4196-a451-30570ebfd2fa">
                <ownedComment xmi:id="aee26cf6-846c-4fa3-81f3-7f6309f2ffdf" body="An &lt;tt>int&lt;/tt> array in which elements may be updated atomically.&#xA;See the {@link java.util.concurrent.atomic} package&#xA;specification for description of the properties of atomic&#xA;variables.&#xA;@since 1.5&#xA;@author Doug Lea&#xA;" annotatedElement="fac8db90-8b58-4cc9-a841-86fd7afe34d8"/>
