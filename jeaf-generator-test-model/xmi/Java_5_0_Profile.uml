            <nestedClassifier xmi:type="uml:Class" xmi:id="739085ac-6afa-4f47-b4cf-bcf6653b64a9" name="DragHandler" visibility="private" clientDependency="e857e926-6972-4271-934d-a4a3f2abea99 b4b92f88-6403-48d6-950a-3fb8c512342d">
