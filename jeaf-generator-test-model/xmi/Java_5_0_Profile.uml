          <packagedElement xmi:type="uml:Interface" xmi:id="c269f8de-99eb-4278-a5f7-97ff69356e65" name="Comparable&lt;SelfComparable>">
            <templateBinding xmi:id="d76393e4-82a5-4aa4-bdce-3cd38d7d2bd0" signature="5ad198c9-2870-4ea9-8c7f-1eac95f41aa9">
