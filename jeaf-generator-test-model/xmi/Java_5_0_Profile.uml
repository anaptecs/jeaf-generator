              <packagedElement xmi:type="uml:Class" xmi:id="e9cfa475-6500-4fc6-a2c3-a46d7cd6872b" name="DefaultSynthStyleFactory" visibility="package">
                <ownedComment xmi:id="68564049-ece2-452c-9e95-55f8d38e7712" body="Factory used for obtaining styles. Supports associating a style based on&#xA;the name of the component as returned by &lt;code>Component.getName()&lt;/code>,&#xA;and the &lt;code>Region&lt;/code> associated with the &lt;code>JComponent&lt;/code>.&#xA;Lookup is done using regular expressions.&#xA;&#xA;@version 1.6, 12/19/03&#xA;@author Scott Violet&#xA;" annotatedElement="e9cfa475-6500-4fc6-a2c3-a46d7cd6872b"/>
