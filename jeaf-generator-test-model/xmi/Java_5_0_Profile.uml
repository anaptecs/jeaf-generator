            </nestedClassifier>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="a5ae007d-9a18-48ad-a95f-22df935ab78e" name="RepaintManager">
            <ownedComment xmi:id="6ed400b8-2edd-4ae3-8157-eba2282d603b" body="This class manages repaint requests, allowing the number&#xA;of repaints to be minimized, for example by collapsing multiple&#xA;requests into a single repaint for members of a component tree.&#xA;&#xA;@version 1.60 02/18/04&#xA;@author Arnaud Weber&#xA;" annotatedElement="a5ae007d-9a18-48ad-a95f-22df935ab78e"/>
