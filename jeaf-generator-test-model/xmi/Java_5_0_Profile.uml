                  <ownedComment xmi:id="eb06534b-5d61-425b-8fb7-a5a161b0eb94" body="Used to layout a MetalSplitPaneDivider. Layout for the divider&#xA;involves appropriately moving the left/right buttons around.&#xA;&lt;p>&#xA;This class should be treated as a &quot;protected&quot; inner class.&#xA;Instantiate it only within subclasses of MetalSplitPaneDivider.&#xA;" annotatedElement="185938d5-00dc-4060-8246-d89fe1fd66c9"/>
                  <interfaceRealization xmi:id="ffcde523-ded6-4fe6-95c3-315313d12ab4" name="" supplier="c3507179-c29c-40a9-8869-092757900e53" client="185938d5-00dc-4060-8246-d89fe1fd66c9" contract="c3507179-c29c-40a9-8869-092757900e53"/>
                </nestedClassifier>
              </packagedElement>
