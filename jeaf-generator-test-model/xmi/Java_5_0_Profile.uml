              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="f5c3c591-579d-45c8-97d2-f8775fa07c30" name="DelayedWorkQueue" visibility="private" clientDependency="4d928511-c2e1-498b-843e-12a7136e662b">
                <ownedComment xmi:id="80a325e7-2e52-4332-aa11-c4eb32c2abda" body="An annoying wrapper class to convince generics compiler to&#xA;use a DelayQueue&lt;ScheduledFutureTask> as a BlockingQueue&lt;Runnable>&#xA;" annotatedElement="f5c3c591-579d-45c8-97d2-f8775fa07c30"/>
