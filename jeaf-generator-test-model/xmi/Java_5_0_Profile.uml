                <nestedClassifier xmi:type="uml:Class" xmi:id="874cec19-9307-48cf-a26f-490ca429fe03" name="ReadLock" clientDependency="6722baa5-29df-4510-9f79-0dc6762333a8 6b5c58ef-5963-455c-8b48-86d6515f0f55">
                  <ownedComment xmi:id="7fc02b29-bcb8-4e22-970a-66ed36c691fa" body="The lock returned by method {@link ReentrantReadWriteLock#readLock}.&#xA;" annotatedElement="874cec19-9307-48cf-a26f-490ca429fe03"/>
                  <interfaceRealization xmi:id="6b5c58ef-5963-455c-8b48-86d6515f0f55" name="" supplier="4eba85f5-43fc-42f6-8527-e200a8e9cbfa" client="874cec19-9307-48cf-a26f-490ca429fe03" contract="4eba85f5-43fc-42f6-8527-e200a8e9cbfa"/>
                  <interfaceRealization xmi:id="6722baa5-29df-4510-9f79-0dc6762333a8" name="" supplier="56bf6aa5-263a-4a52-8bf0-175f4238b77e" client="874cec19-9307-48cf-a26f-490ca429fe03" contract="56bf6aa5-263a-4a52-8bf0-175f4238b77e"/>
