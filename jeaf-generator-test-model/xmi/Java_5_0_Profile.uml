              </nestedClassifier>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="c54aab92-4cdc-4986-9ff5-2c5b64b00d95" name="MutableTreeNode" isAbstract="true">
              <ownedComment xmi:id="092b8bca-f59b-49c0-9de3-bfaa3327d1f5" body="Defines the requirements for a tree node object that can change --&#xA;by adding or removing child nodes, or by changing the contents&#xA;of a user object stored in the node.&#xA;&#xA;@see DefaultMutableTreeNode&#xA;@see javax.swing.JTree&#xA;&#xA;@version 1.11 12/19/03&#xA;@author Rob Davis&#xA;@author Scott Violet&#xA;" annotatedElement="c54aab92-4cdc-4986-9ff5-2c5b64b00d95"/>
