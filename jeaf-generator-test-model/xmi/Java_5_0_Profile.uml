            <nestedClassifier xmi:type="uml:Class" xmi:id="c011049d-91e7-4f99-bd22-b5ebe761d1f8" name="Enumerator" visibility="private" clientDependency="c4bf441c-d9f5-418e-9b38-1dc53e2a2f6e c98b1270-1b20-48d6-911f-6d12a27563f3">
              <ownedComment xmi:id="00186fb9-ce06-4819-a691-eac7d78e90d1" body="A hashtable enumerator class.  This class implements both the&#xA;Enumeration and Iterator interfaces, but individual instances&#xA;can be created with the Iterator methods disabled.  This is necessary&#xA;to avoid unintentionally increasing the capabilities granted a user&#xA;by passing an Enumeration.&#xA;" annotatedElement="c011049d-91e7-4f99-bd22-b5ebe761d1f8"/>
              <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="0f03fbb5-8858-45f6-9561-916d8de88dfd" name="" parameter="e45fba54-38ab-4e1b-a0e1-700be51af824">
