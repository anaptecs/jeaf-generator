          <packagedElement xmi:type="uml:Class" xmi:id="816c8c9d-0313-484e-b458-0496f5e2e07e" name="javax_swing_Box_PersistenceDelegate" visibility="package">
            <generalization xmi:id="fcf774e3-f78e-4d41-ac72-722809c34cd7" isSubstitutable="true" general="24ac82dc-d404-474f-932a-2f87e75356f8"/>
