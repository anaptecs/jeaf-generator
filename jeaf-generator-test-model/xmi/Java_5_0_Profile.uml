            </nestedClassifier>
            <nestedClassifier xmi:type="uml:Class" xmi:id="99b0d3e3-e629-4951-afb2-de993b508a78" name="AccessibleJTabbedPane" visibility="protected" clientDependency="6cdd0829-777b-4be7-a6d6-d0314aad10ea 124b594e-e72d-4eb5-a87f-f80baf6dd50b">
              <ownedComment xmi:id="8f4e31a3-c52d-43ec-b55e-ba0f0685f3a7" body="This class implements accessibility support for the&#xA;&lt;code>JTabbedPane&lt;/code> class.  It provides an implementation of the&#xA;Java Accessibility API appropriate to tabbed pane user-interface&#xA;elements.&#xA;&lt;p>&#xA;&lt;strong>Warning:&lt;/strong>&#xA;Serialized objects of this class will not be compatible with&#xA;future Swing releases. The current serialization support is&#xA;appropriate for short term storage or RMI between applications running&#xA;the same version of Swing.  As of 1.4, support for long term storage&#xA;of all JavaBeans&lt;sup>&lt;font size=&quot;-2&quot;>TM&lt;/font>&lt;/sup>&#xA;has been added to the &lt;code>java.beans&lt;/code> package.&#xA;Please see {@link java.beans.XMLEncoder}.&#xA;" annotatedElement="99b0d3e3-e629-4951-afb2-de993b508a78"/>
              <generalization xmi:id="36a09751-ee47-44cf-aafc-ad9486d19853" isSubstitutable="true" general="7476a5d9-16dc-482c-bb13-90f59bc1c7b6"/>
              <interfaceRealization xmi:id="6cdd0829-777b-4be7-a6d6-d0314aad10ea" name="" supplier="0dbef058-3ccc-4038-b98f-eea279be3f13" client="99b0d3e3-e629-4951-afb2-de993b508a78" contract="0dbef058-3ccc-4038-b98f-eea279be3f13"/>
              <interfaceRealization xmi:id="124b594e-e72d-4eb5-a87f-f80baf6dd50b" name="" supplier="334e76ee-f6d5-4094-b3f5-494be7414f2c" client="99b0d3e3-e629-4951-afb2-de993b508a78" contract="334e76ee-f6d5-4094-b3f5-494be7414f2c"/>
            </nestedClassifier>
            <nestedClassifier xmi:type="uml:Class" xmi:id="ba51673a-5483-4dfa-b8db-ca11955db542" name="Page" visibility="private" clientDependency="b978c21b-1a32-481c-a112-63a05b9adb88 97555cc6-0ec4-4657-a3ba-32f5540d7036 29a7bf5f-3c9e-4d98-a2b3-2a4d9d3f3738">
              <generalization xmi:id="ceb3361e-3ee9-4517-82b7-f068705bd49f" isSubstitutable="true" general="5e5fecb3-251d-4b0e-b142-9f3aac1d4c57"/>
              <interfaceRealization xmi:id="97555cc6-0ec4-4657-a3ba-32f5540d7036" name="" supplier="56bf6aa5-263a-4a52-8bf0-175f4238b77e" client="ba51673a-5483-4dfa-b8db-ca11955db542" contract="56bf6aa5-263a-4a52-8bf0-175f4238b77e"/>
              <interfaceRealization xmi:id="b978c21b-1a32-481c-a112-63a05b9adb88" name="" supplier="ed907a69-6a73-461b-8000-495b37bdc076" client="ba51673a-5483-4dfa-b8db-ca11955db542" contract="ed907a69-6a73-461b-8000-495b37bdc076"/>
