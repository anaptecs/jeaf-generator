              </ownedParameter>
            </ownedTemplateSignature>
            <generalization xmi:id="03ce875d-2dac-4fd5-830c-6609ad1fa6c9" isSubstitutable="true" general="ee758153-f931-43ca-bcea-40b9d95c713b"/>
            <interfaceRealization xmi:id="4c2a99e9-2ef5-4fe7-bf03-175e2c751687" name="" supplier="18dc6102-a040-4ae1-aefe-698abc18de28" client="18193b0c-b68c-4a5e-ba9a-01ccc68917e6" contract="18dc6102-a040-4ae1-aefe-698abc18de28"/>
            <interfaceRealization xmi:id="0acd2a0e-b947-45c9-83d2-30a10e7680b5" name="" supplier="29add607-d540-4560-b2b3-2e3c9d7f8dd2" client="18193b0c-b68c-4a5e-ba9a-01ccc68917e6" contract="29add607-d540-4560-b2b3-2e3c9d7f8dd2"/>
