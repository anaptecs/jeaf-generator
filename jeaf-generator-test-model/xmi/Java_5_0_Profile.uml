            <packagedElement xmi:type="uml:Class" xmi:id="aa7ccea0-1023-4cce-95e9-5661131c891d" name="OpenMBeanInfoSupport" clientDependency="b4294b64-2464-4ea4-b3bd-1c9d95771b2a 4ec5c170-c4e7-4ded-a996-57d20f6a8590">
              <ownedComment xmi:id="b5f96f02-3108-4da2-af6d-393e6c8638af" body="The &lt;tt>OpenMBeanInfoSupport&lt;/tt> class describes the management information of an &lt;i>open MBean&lt;/i>:&#xA;it is a subclass of {@link javax.management.MBeanInfo}, and it implements the {@link OpenMBeanInfo} interface.&#xA;Note that an &lt;i>open MBean&lt;/i> is recognized as such if its &lt;tt>getMBeanInfo()&lt;/tt> method returns an instance of a class&#xA;which implements the OpenMBeanInfo interface, typically &lt;tt>OpenMBeanInfoSupport&lt;/tt>.&#xA;&#xA;@version     3.22  03/12/19&#xA;@author      Sun Microsystems, Inc.&#xA;&#xA;@since 1.5&#xA;@since.unbundled JMX 1.1&#xA;" annotatedElement="aa7ccea0-1023-4cce-95e9-5661131c891d"/>
              <generalization xmi:id="699808ea-28aa-4daf-8f23-e8caa0d24fcb" isSubstitutable="true" general="f73dc7a0-1d90-48b8-8326-32cb80abeff5"/>
              <interfaceRealization xmi:id="b4294b64-2464-4ea4-b3bd-1c9d95771b2a" name="" supplier="ca134ad8-4c5e-4c5e-a9d4-b82eda33f404" client="aa7ccea0-1023-4cce-95e9-5661131c891d" contract="ca134ad8-4c5e-4c5e-a9d4-b82eda33f404"/>
              <interfaceRealization xmi:id="4ec5c170-c4e7-4ded-a996-57d20f6a8590" name="" supplier="56bf6aa5-263a-4a52-8bf0-175f4238b77e" client="aa7ccea0-1023-4cce-95e9-5661131c891d" contract="56bf6aa5-263a-4a52-8bf0-175f4238b77e"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="2cd9af8a-18ab-4d83-9b1b-e265e8d00668" name="TabularDataSupport" clientDependency="354967c9-116e-448d-8533-755dd5cf20e8 865ec035-4cda-4824-ab42-59ac8b75139a 241e7d91-2e46-43a0-a755-901627cf61fb 35d027d3-e791-4423-ba00-1e1cd461bf4d">
              <ownedComment xmi:id="6b7ed50f-b7bd-4e16-9d11-d81621035230" body="The &lt;tt>TabularDataSupport&lt;/tt> class is the &lt;i>open data&lt;/i> class which implements the &lt;tt>TabularData&lt;/tt>&#xA;and the &lt;tt>Map&lt;/tt> interfaces, and which is internally based on a hash map data structure.&#xA;&#xA;@version     3.30  03/12/19&#xA;@author      Sun Microsystems, Inc.&#xA;&#xA;@since 1.5&#xA;@since.unbundled JMX 1.1&#xA;" annotatedElement="2cd9af8a-18ab-4d83-9b1b-e265e8d00668"/>
              <interfaceRealization xmi:id="354967c9-116e-448d-8533-755dd5cf20e8" name="" supplier="df787128-15e8-4985-a5fa-f78238a28dd5" client="2cd9af8a-18ab-4d83-9b1b-e265e8d00668" contract="df787128-15e8-4985-a5fa-f78238a28dd5"/>
