          <packagedElement xmi:type="uml:Class" xmi:id="e9e1f358-b93c-4067-bffb-72bc6062f682" name="BufferUnderflowException">
            <ownedComment xmi:id="0f2e34cc-7129-4370-bf13-15fffb218ca3" body="Unchecked exception thrown when a relative &lt;i>get&lt;/i> operation reaches&#xA;the source buffer's limit.&#xA;&#xA;@version 1.14, 01/05/02&#xA;@since 1.4&#xA;" annotatedElement="e9e1f358-b93c-4067-bffb-72bc6062f682"/>
