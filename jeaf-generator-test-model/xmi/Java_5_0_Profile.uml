            <nestedClassifier xmi:type="uml:Class" xmi:id="51f71785-1b65-4901-b324-ec5c58b2c180" name="SimpleEntry" visibility="package" clientDependency="2968c817-61f9-49de-b06d-d5d427c3a1af">
              <ownedComment xmi:id="7445cae4-e133-4d55-a05c-e05a5238b099" body="This should be made public as soon as possible.  It greatly simplifies&#xA;the task of implementing Map.&#xA;" annotatedElement="51f71785-1b65-4901-b324-ec5c58b2c180"/>
