                  <ownedComment xmi:id="f9ad0cba-1076-4ded-bcc5-bfc8fb891e43" body="This inner class is marked &quot;public&quot; due to a compiler bug.&#xA;This class should be treated as a &quot;protected&quot; inner class.&#xA;Instantiate it only within subclasses of BasicOptionPaneUI.&#xA;" annotatedElement="280056a9-5936-4377-9c8e-2aac9685d806"/>
