                <nestedClassifier xmi:type="uml:Class" xmi:id="6861130f-454c-4561-80a7-ae7b421112c1" name="TableElementInfo" visibility="private" clientDependency="2ed04712-d604-4c52-a795-cc44c0f5364d">
                  <ownedComment xmi:id="0426b4cc-36a8-4666-a902-30826285d3ea" body="TableElementInfo encapsulates information about a HTML.Tag.TABLE.&#xA;To make access fast it crates a grid containing the children to&#xA;allow for access by row, column. TableElementInfo will contain&#xA;TableRowElementInfos, which will contain TableCellElementInfos.&#xA;Any time one of the rows or columns becomes invalid the table is&#xA;invalidated.  This is because any time one of the child attributes&#xA;changes the size of the grid may have changed.&#xA;" annotatedElement="6861130f-454c-4561-80a7-ae7b421112c1"/>
                  <generalization xmi:id="d9d92247-b790-4187-9b9a-b2524e6f3716" isSubstitutable="true" general="02bad119-7eea-4d36-afdf-8a6e765452bc"/>
                  <interfaceRealization xmi:id="2ed04712-d604-4c52-a795-cc44c0f5364d" name="" supplier="ed907a69-6a73-461b-8000-495b37bdc076" client="6861130f-454c-4561-80a7-ae7b421112c1" contract="ed907a69-6a73-461b-8000-495b37bdc076"/>
                  <nestedClassifier xmi:type="uml:Class" xmi:id="f4529e94-f528-449d-900a-f2973ac86096" name="TableAccessibleContext" clientDependency="05d31afb-e872-4c87-bd53-f6675563e1c8">
                    <generalization xmi:id="470b974e-76ac-46dc-9dc1-b146b96dddcc" isSubstitutable="true" general="ca0cd01c-e59c-47bf-9259-077ad16b07c5"/>
