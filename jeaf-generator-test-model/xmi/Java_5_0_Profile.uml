              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="9f0e4370-490d-412d-a571-bac51f092aa5" name="AccessibleJTableHeader" visibility="protected">
                <ownedComment xmi:id="304d8219-6f38-4147-b934-0929b447bfa1" body="This class implements accessibility support for the&#xA;&lt;code>JTableHeader&lt;/code> class.  It provides an implementation of the&#xA;Java Accessibility API appropriate to table header user-interface&#xA;elements.&#xA;&lt;p>&#xA;&lt;strong>Warning:&lt;/strong>&#xA;Serialized objects of this class will not be compatible with&#xA;future Swing releases. The current serialization support is&#xA;appropriate for short term storage or RMI between applications running&#xA;the same version of Swing.  As of 1.4, support for long term storage&#xA;of all JavaBeans&lt;sup>&lt;font size=&quot;-2&quot;>TM&lt;/font>&lt;/sup>&#xA;has been added to the &lt;code>java.beans&lt;/code> package.&#xA;Please see {@link java.beans.XMLEncoder}.&#xA;" annotatedElement="9f0e4370-490d-412d-a571-bac51f092aa5"/>
                <generalization xmi:id="660e46dc-08de-4b22-97f0-f0550d0a2e2d" isSubstitutable="true" general="7476a5d9-16dc-482c-bb13-90f59bc1c7b6"/>
                <nestedClassifier xmi:type="uml:Class" xmi:id="9ef29696-db1b-4ed1-b737-a3cdb6dbe22c" name="AccessibleJTableHeaderEntry" visibility="protected" clientDependency="00c1e61e-b4a2-47c0-9ae2-d5b52540909c 8507199d-5318-45b9-a501-33c5a4c3169a">
                  <ownedComment xmi:id="42b9143e-af4b-4947-a549-6c05d455c4b2" body="This class provides an implementation of the Java Accessibility&#xA;API appropropriate for JTableHeader entries.&#xA;" annotatedElement="9ef29696-db1b-4ed1-b737-a3cdb6dbe22c"/>
                  <generalization xmi:id="5770ea61-81d7-467c-a77a-86428665b701" isSubstitutable="true" general="5e5fecb3-251d-4b0e-b142-9f3aac1d4c57"/>
                  <interfaceRealization xmi:id="8507199d-5318-45b9-a501-33c5a4c3169a" name="" supplier="ed907a69-6a73-461b-8000-495b37bdc076" client="9ef29696-db1b-4ed1-b737-a3cdb6dbe22c" contract="ed907a69-6a73-461b-8000-495b37bdc076"/>
                  <interfaceRealization xmi:id="00c1e61e-b4a2-47c0-9ae2-d5b52540909c" name="" supplier="a13045dc-df1a-4751-8aff-9b7e320e05bf" client="9ef29696-db1b-4ed1-b737-a3cdb6dbe22c" contract="a13045dc-df1a-4751-8aff-9b7e320e05bf"/>
