              <packagedElement xmi:type="uml:Class" xmi:id="52e6fccc-0c76-4505-b7b3-33622ad508fd" name="SynthSplitPaneUI" visibility="package" clientDependency="71724e2b-78f7-4e3f-b20c-87dfe3e3d462">
