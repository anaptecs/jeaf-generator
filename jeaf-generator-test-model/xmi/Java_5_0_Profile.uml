              <packagedElement xmi:type="uml:Class" xmi:id="6343f858-4c8a-4254-a72b-38bb9a941fd1" name="BasicPasswordFieldUI">
                <ownedComment xmi:id="e2880b89-5c96-4d35-8cc7-f70bfec22a21" body="Provides the Windows look and feel for a password field.&#xA;The only difference from the standard text field is that&#xA;the view of the text is simply a string of the echo&#xA;character as specified in JPasswordField, rather than the&#xA;real text contained in the field.&#xA;&#xA;@author  Timothy Prinzing&#xA;@version 1.30 12/19/03&#xA;" annotatedElement="6343f858-4c8a-4254-a72b-38bb9a941fd1"/>
                <generalization xmi:id="32fe4bae-ce87-4337-99a1-0784f23e1dd3" isSubstitutable="true" general="289b701d-6a86-42ec-8cfb-29415722efca"/>
