            <generalization xmi:id="1856d023-cd5a-4ebd-9f67-a21cdf975c23" isSubstitutable="true" general="ee758153-f931-43ca-bcea-40b9d95c713b"/>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="80c56855-fdeb-460b-8a5f-6d68a053d408" name="Arrays">
            <ownedComment xmi:id="a12a7495-029f-4cf5-8ad0-c22b2a281bb6" body="This class contains various methods for manipulating arrays (such as&#xA;sorting and searching).  This class also contains a static factory&#xA;that allows arrays to be viewed as lists.&#xA;&#xA;&lt;p>The methods in this class all throw a &lt;tt>NullPointerException&lt;/tt> if&#xA;the specified array reference is null, except where noted.&#xA;&#xA;&lt;p>The documentation for the methods contained in this class includes&#xA;briefs description of the &lt;i>implementations&lt;/i>.  Such descriptions should&#xA;be regarded as &lt;i>implementation notes&lt;/i>, rather than parts of the&#xA;&lt;i>specification&lt;/i>.  Implementors should feel free to substitute other&#xA;algorithms, so long as the specification itself is adhered to.  (For&#xA;example, the algorithm used by &lt;tt>sort(Object[])&lt;/tt> does not have to be&#xA;a mergesort, but it does have to be &lt;i>stable&lt;/i>.)&#xA;&#xA;&lt;p>This class is a member of the&#xA;&lt;a href=&quot;{@docRoot}/../guide/collections/index.html&quot;>&#xA;Java Collections Framework&lt;/a>.&#xA;&#xA;@author  Josh Bloch&#xA;@author  Neal Gafter&#xA;@version 1.59, 04/01/04&#xA;@see     Comparable&#xA;@see     Comparator&#xA;@since   1.2&#xA;" annotatedElement="80c56855-fdeb-460b-8a5f-6d68a053d408"/>
            <nestedClassifier xmi:type="uml:Class" xmi:id="9d505321-7e60-4a09-8e2c-ae30cc858754" name="ArrayList" visibility="private" clientDependency="77956bcd-40df-4158-96fb-cc46398f109a e1df733a-fc7f-4a68-894d-5cac9850e264">
