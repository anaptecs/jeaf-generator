              <packagedElement xmi:type="uml:Class" xmi:id="a6460f8a-3254-4e8e-8b1e-a654c6fad3fb" name="CachedPainter" visibility="package" isAbstract="true">
                <ownedComment xmi:id="771330cf-0044-466a-860a-fbca3ee66292" body="A base class used for icons or images that are expensive to paint.&#xA;A subclass will do the following:&#xA;&lt;ol>&#xA;&lt;li>Invoke &lt;code>paint&lt;/code> when you want to paint the image,&#xA;if you are implementing &lt;code>Icon&lt;/code> you'll invoke this from&#xA;&lt;code>paintIcon&lt;/code>.&#xA;The args argument is useful when additional state is needed.&#xA;&lt;li>Override &lt;code>paintToImage&lt;/code> to render the image.  The code that&#xA;lives here is equivalent to what previously would go in&#xA;&lt;code>paintIcon&lt;/code>, for an &lt;code>Icon&lt;/code>.&#xA;&lt;/ol>&#xA;&#xA;@version @(#)CachedPainter.java&#x9;1.2 04/02/15&#xA;" annotatedElement="a6460f8a-3254-4e8e-8b1e-a654c6fad3fb"/>
                <nestedClassifier xmi:type="uml:Class" xmi:id="1bd5039b-2d0c-45ed-a8f1-49dc82525487" name="Cache" visibility="private">
                  <ownedComment xmi:id="abd8ed58-6827-4cc7-acd1-db4cb7ab61d8" body="Cache is used to cache an image based on a set of arguments.&#xA;" annotatedElement="1bd5039b-2d0c-45ed-a8f1-49dc82525487"/>
                  <nestedClassifier xmi:type="uml:Class" xmi:id="efd7e9cd-3e61-4a40-b817-c3a3f5fdc146" name="Entry" visibility="private">
                    <ownedComment xmi:id="2e33ffe3-ae32-4c0d-afce-9b4b6c3e9e16" body="Caches set of arguments and Image.&#xA;" annotatedElement="efd7e9cd-3e61-4a40-b817-c3a3f5fdc146"/>
                  </nestedClassifier>
                </nestedClassifier>
              </packagedElement>
