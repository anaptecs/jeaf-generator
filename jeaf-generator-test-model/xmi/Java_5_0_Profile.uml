            </nestedClassifier>
            <nestedClassifier xmi:type="uml:Class" xmi:id="69adafc9-cb1b-46b3-9741-729098ecab50" name="AccessibleJPopupMenu" visibility="protected" clientDependency="8abde2d9-f3ee-4519-b815-776c71fb87f5">
              <ownedComment xmi:id="6583676c-591e-4be8-96e5-4ad21b299866" body="This class implements accessibility support for the&#xA;&lt;code>JPopupMenu&lt;/code> class.  It provides an implementation of the&#xA;Java Accessibility API appropriate to popup menu user-interface&#xA;elements.&#xA;" annotatedElement="69adafc9-cb1b-46b3-9741-729098ecab50"/>
