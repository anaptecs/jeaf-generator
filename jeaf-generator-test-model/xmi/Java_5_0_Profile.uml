            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="8da5cdfa-da8e-47f3-8a62-21592e5a5794" name="RSAMultiPrimePrivateCrtKeySpec">
              <ownedComment xmi:id="f4694f96-e1b0-4c49-9a9a-22de68cf64df" body="This class specifies an RSA multi-prime private key, as defined in the&#xA;PKCS#1 v2.1, using the Chinese Remainder Theorem (CRT) information&#xA;values for efficiency.&#xA;&#xA;@author Valerie Peng&#xA;&#xA;@version 1.8 03/12/19&#xA;&#xA;@see java.security.Key&#xA;@see java.security.KeyFactory&#xA;@see KeySpec&#xA;@see PKCS8EncodedKeySpec&#xA;@see RSAPrivateKeySpec&#xA;@see RSAPublicKeySpec&#xA;@see RSAOtherPrimeInfo&#xA;&#xA;@since 1.4&#xA;" annotatedElement="8da5cdfa-da8e-47f3-8a62-21592e5a5794"/>
