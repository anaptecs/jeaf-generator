              <interfaceRealization xmi:id="818ca46c-dd48-451a-aace-aaf4171ce9c7" name="" supplier="56bf6aa5-263a-4a52-8bf0-175f4238b77e" client="b789d965-f9a5-473b-b133-d0caf112f70f" contract="56bf6aa5-263a-4a52-8bf0-175f4238b77e"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="e16f82a3-e106-4938-8674-8c26721a643e" name="BeanContextServicesListener" isAbstract="true">
              <ownedComment xmi:id="19f705c8-e106-4cb3-8949-5e83e8a3e070" body="The listener interface for receiving&#xA;&lt;code>BeanContextServiceAvailableEvent&lt;/code> objects.&#xA;A class that is interested in processing a&#xA;&lt;code>BeanContextServiceAvailableEvent&lt;/code> implements this interface.&#xA;" annotatedElement="e16f82a3-e106-4938-8674-8c26721a643e"/>
              <generalization xmi:id="77b9c124-9afb-41b9-af0b-c0fb96101254" isSubstitutable="true" general="0253727f-902d-44ab-b6dc-e1bc5fdf0604"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="323bf951-a074-4223-93db-47d4c76f6756" name="BeanContextServicesSupport" clientDependency="ab085c47-368d-4954-9db8-23132eaaf167">
              <ownedComment xmi:id="94222d77-8e2a-4a91-9e82-0bf509b3676e" body="&lt;p>&#xA;This helper class provides a utility implementation of the&#xA;java.beans.beancontext.BeanContextServices interface.&#xA;&lt;/p>&#xA;&lt;p>&#xA;Since this class directly implements the BeanContextServices interface,&#xA;the class can, and is intended to be used either by subclassing this&#xA;implementation, or via delegation of an instance of this class&#xA;from another through the BeanContextProxy interface.&#xA;&lt;/p>&#xA;&#xA;@author Laurence P. G. Cable&#xA;@version 1.23, 04/15/04&#xA;@since 1.2&#xA;" annotatedElement="323bf951-a074-4223-93db-47d4c76f6756"/>
              <generalization xmi:id="0cc8d4ad-caf9-40be-8115-5b55875f0d0e" isSubstitutable="true" general="beba0dea-518d-476d-b81d-3142d98cd0f3"/>
