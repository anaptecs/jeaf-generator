              <nestedClassifier xmi:type="uml:Class" xmi:id="f50386cf-94f8-4e05-a08f-f5e7ba05ec8e" name="HashEntry" visibility="package" isLeaf="true">
                <ownedComment xmi:id="a49aaf7d-2007-4eb5-8ed8-cf2db66a69a6" body="ConcurrentHashMap list entry. Note that this is never exported&#xA;out as a user-visible Map.Entry.&#xA;&#xA;Because the value field is volatile, not final, it is legal wrt&#xA;the Java Memory Model for an unsynchronized reader to see null&#xA;instead of initial value when read via a data race.  Although a&#xA;reordering leading to this is not likely to ever actually&#xA;occur, the Segment.readValueUnderLock method is used as a&#xA;backup in case a null (pre-initialized) value is ever seen in&#xA;an unsynchronized access method.&#xA;" annotatedElement="f50386cf-94f8-4e05-a08f-f5e7ba05ec8e"/>
                <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="ab8ad0f7-7f35-4a9a-9502-41792ccd8bae" name="" parameter="c2551e08-c36d-4de3-8a3a-a2a46695a369 b1e2d5ef-ed7d-4d05-bfd2-0e8fa1db19e0">
