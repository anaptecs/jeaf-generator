            <packagedElement xmi:type="uml:Class" xmi:id="a49a177f-1677-45d3-8ee6-632ecfb5aa1f" name="ExpandVetoException">
              <ownedComment xmi:id="605df846-43a0-4cbb-b70e-5dc233b97952" body="Exception used to stop and expand/collapse from happening.&#xA;See &lt;a&#xA;href=&quot;http://java.sun.com/docs/books/tutorial/uiswing/events/treewillexpandlistener.html&quot;>How to Write a Tree-Will-Expand Listener&lt;/a>&#xA;in &lt;em>The Java Tutorial&lt;/em>&#xA;for further information and examples.&#xA;&#xA;@version 1.10 12/19/03&#xA;@author Scott Violet&#xA;" annotatedElement="a49a177f-1677-45d3-8ee6-632ecfb5aa1f"/>
