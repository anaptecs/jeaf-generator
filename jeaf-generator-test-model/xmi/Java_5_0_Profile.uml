              <nestedClassifier xmi:type="uml:Class" xmi:id="6db7c662-5e40-4ecb-ae3b-823bd6993cab" name="AttributeUndoableEdit">
                <ownedComment xmi:id="f79d2588-c696-4522-b8dc-1b5552ce2613" body="An UndoableEdit used to remember AttributeSet changes to an&#xA;Element.&#xA;" annotatedElement="6db7c662-5e40-4ecb-ae3b-823bd6993cab"/>
