              <nestedClassifier xmi:type="uml:Class" xmi:id="33733965-d6e3-440d-afce-1311a3580272" name="InputMethodRequestsHandler" visibility="package" clientDependency="e15c552c-7989-4685-9840-af0ebc45bab1 a6318f4d-d8a8-4f11-82b7-583ce0076085">
