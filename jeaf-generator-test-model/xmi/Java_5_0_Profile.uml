                  <ownedComment xmi:id="e9c57ca8-7755-456f-95b7-642cfbb3c2b6" body="This listener watches for changes to the selection in the&#xA;combo box.&#xA;" annotatedElement="5aeeaf64-fc22-4fd2-b44d-ed7de85decce"/>
