            <packagedElement xmi:type="uml:Interface" xmi:id="b2c4f843-2a70-44a1-b698-de4bd3875bb0" name="Enumeration&lt;V>">
              <templateBinding xmi:id="61e22370-e62a-41ac-9e93-da915bfb3c65" signature="521c8bf5-b0b1-4a86-820c-0614950913b8">
                <parameterSubstitution xmi:id="cd5a241c-754c-42a6-94e3-b804746d3600" formal="0dc15cf5-0f68-454b-a4d7-227d89f2d0c5" actual="6e16dbee-010f-4cc1-a091-a6a0310dcd56"/>
