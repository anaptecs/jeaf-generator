              <nestedClassifier xmi:type="uml:Class" xmi:id="e8b21f1b-581c-48d2-92e5-e5bdc200bacd" name="StyleChangeHandler" visibility="package" clientDependency="44986647-88b2-4ced-b471-5ebe5660a6f9">
                <ownedComment xmi:id="052ad19a-00e7-4c0b-982d-fe92bb816365" body="Added to all the Styles. When instances of this receive a&#xA;stateChanged method, styleChanged is invoked.&#xA;" annotatedElement="e8b21f1b-581c-48d2-92e5-e5bdc200bacd"/>
