                <nestedClassifier xmi:type="uml:Class" xmi:id="ddbcd4d6-b293-4e5c-bef9-e77ecff82f11" name="Actions" visibility="private">
                  <ownedComment xmi:id="715c71e6-5e86-4558-b485-6964e4acfa60" body="Actions for Buttons. Two type of action are supported:&#xA;pressed: Moves the button to a pressed state&#xA;released: Disarms the button.&#xA;" annotatedElement="ddbcd4d6-b293-4e5c-bef9-e77ecff82f11"/>
