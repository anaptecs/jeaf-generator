              <interfaceRealization xmi:id="a01dbdcf-e653-405d-a70c-8eda368acc3c" name="" supplier="1dd642cc-ad4c-43b8-91c1-a201cb5d8292" client="da7ae63b-1d41-416b-b2ba-26253fd43a56" contract="1dd642cc-ad4c-43b8-91c1-a201cb5d8292"/>
