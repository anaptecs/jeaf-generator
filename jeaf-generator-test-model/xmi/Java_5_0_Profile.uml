            <packagedElement xmi:type="uml:Class" xmi:id="be04b0f0-53f6-42f8-ac76-56e8ed1bc043" name="ExecutionException">
              <ownedComment xmi:id="3d49ecdb-fb73-4aca-8348-c5d68ab4f83b" body="Exception thrown when attempting to retrieve the result of a task&#xA;that aborted by throwing an exception. This exception can be&#xA;inspected using the {@link #getCause()} method.&#xA;&#xA;@see Future&#xA;@since 1.5&#xA;@author Doug Lea&#xA;" annotatedElement="be04b0f0-53f6-42f8-ac76-56e8ed1bc043"/>
              <generalization xmi:id="6140db6b-91c7-43c6-9fce-0d6f005b4eae" isSubstitutable="true" general="d9873bd2-3a74-4e59-8f22-c1deb5d08955"/>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="b5eaa913-ac40-4b35-bf06-e3638ddc059a" name="Map&lt;K, V>">
              <templateBinding xmi:id="55575503-2d9e-4f56-9241-68a56a9559f4" signature="6fa510d5-30ff-4915-9f85-f28c17685f05">
                <parameterSubstitution xmi:id="817ad0df-21c3-49be-8d4b-0a78acb163cf" formal="c51fa5e3-696f-4fba-aca1-bf27a9542c44" actual="846c1715-eda9-40f6-8281-54cdfc0cfd44"/>
                <parameterSubstitution xmi:id="70b27850-590a-402b-850b-2b83b0c3ad2e" formal="f697aee6-8b2e-4b17-abc4-4158aecc3c87" actual="929127a4-a553-4490-8493-d712132279e2"/>
