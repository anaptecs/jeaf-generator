          <packagedElement xmi:type="uml:Class" xmi:id="2333b373-056e-41a1-8382-9789ac6f6d46" name="CheckedList&lt;E>">
            <templateBinding xmi:id="29067d5f-88cf-42d8-adf6-543c847f1346" signature="841dd6d2-3e10-400a-9904-576e5a00ec00">
              <parameterSubstitution xmi:id="59af4abd-d7be-427f-9f13-0c8b3053cd8b" formal="cfbcdc95-ece9-4c57-acd3-d18a6f3b2027" actual="e3f7699d-d191-4c56-b5b0-254252b178d9"/>
