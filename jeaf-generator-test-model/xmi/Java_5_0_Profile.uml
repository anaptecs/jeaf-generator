              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="c82d556b-44fe-4b74-a97d-144189d40b10" name="LifoWaitQueue" visibility="package" clientDependency="a31a5cb4-8190-4795-9925-2c068dde4c34" isLeaf="true">
                <ownedComment xmi:id="223e2eb6-01c6-4b29-9e11-4476f2a9bc80" body="LIFO queue to hold waiting puts/takes.&#xA;" annotatedElement="c82d556b-44fe-4b74-a97d-144189d40b10"/>
                <generalization xmi:id="569bf51d-0fce-4f4a-a8d5-e4eee62700a2" isSubstitutable="true" general="684cc46c-4f7d-4b15-bb95-79a380d867e4"/>
                <interfaceRealization xmi:id="a31a5cb4-8190-4795-9925-2c068dde4c34" name="" supplier="56bf6aa5-263a-4a52-8bf0-175f4238b77e" client="c82d556b-44fe-4b74-a97d-144189d40b10" contract="56bf6aa5-263a-4a52-8bf0-175f4238b77e"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="8ef5f8d5-a50b-4315-88f1-53ee83a013e1" name="Node" visibility="package" isLeaf="true">
                <ownedComment xmi:id="e6e16f65-deea-44d1-8c1d-3f931ec458e9" body="Nodes each maintain an item and handle waits and signals for&#xA;getting and setting it. The class extends&#xA;AbstractQueuedSynchronizer to manage blocking, using AQS state&#xA;0 for waiting, 1 for ack, -1 for cancelled.&#xA;" annotatedElement="8ef5f8d5-a50b-4315-88f1-53ee83a013e1"/>
                <generalization xmi:id="2ebee1c5-e1c3-4c4b-b5b8-03f1494cfd9c" isSubstitutable="true" general="b2096acc-0bdf-4dbc-95e0-4d21844c1bbc"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="d840e37d-ab6c-4570-985e-7c1bb2c41637" name="EmptyIterator" visibility="package" clientDependency="7c539ca3-a1d4-4b51-a6a1-139763710452">
