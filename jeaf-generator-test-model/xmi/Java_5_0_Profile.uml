              <nestedClassifier xmi:type="uml:Class" xmi:id="59bc7bb8-c9b7-4d7b-822b-0234848544ca" name="Segment" visibility="package" clientDependency="c4982f34-5145-46aa-8e2e-d49abac39c31" isLeaf="true">
                <ownedComment xmi:id="d8edb7c7-bf15-4af3-9ee9-e5b917f7c66d" body="Segments are specialized versions of hash tables.  This&#xA;subclasses from ReentrantLock opportunistically, just to&#xA;simplify some locking and avoid separate construction.&#xA;" annotatedElement="59bc7bb8-c9b7-4d7b-822b-0234848544ca"/>
