        <packagedElement xmi:type="uml:Package" xmi:id="e699f53d-d3e3-4c0a-9c5a-c15d1e0eedaf" name="beans">
          <packagedElement xmi:type="uml:Interface" xmi:id="b548bd16-341a-4f73-88bd-d65014ec5997" name="PropertyChangeListener" isAbstract="true">
            <ownedComment xmi:id="45f3d03e-0ee6-4632-bf8c-6a49bd7a7058" body="A &quot;PropertyChange&quot; event gets fired whenever a bean changes a &quot;bound&quot;&#xA;property.  You can register a PropertyChangeListener with a source&#xA;bean so as to be notified of any bound property updates.&#xA;" annotatedElement="b548bd16-341a-4f73-88bd-d65014ec5997"/>
            <generalization xmi:id="4bed3713-01d4-4c66-a49f-cae3457b0fd0" isSubstitutable="true" general="4a082587-0c9e-4fc6-950d-861bfb398882"/>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="ef7933a3-a0ad-40b2-81e2-9420240567ac" name="java_lang_Class_PersistenceDelegate" visibility="package">
