              <nestedClassifier xmi:type="uml:Class" xmi:id="90aed7c1-38e7-4248-836b-7d706016871d" name="SynchronizedPrintServiceAttributeSet" visibility="private" clientDependency="de4d9c55-ce12-47cc-be01-68bd9c15c80a f1ae9324-e6ed-4444-9b8d-193cb401e3d3">
                <ownedComment xmi:id="bd9ff4a7-773f-41bc-adac-ef2e0f6de82e" body="@serial include&#xA;" annotatedElement="90aed7c1-38e7-4248-836b-7d706016871d"/>
                <generalization xmi:id="8fc8eb9a-b11a-40ef-b1cd-7874ab8a2c40" isSubstitutable="true" general="58063c3e-5fcb-43df-8104-af807f5158b5"/>
                <interfaceRealization xmi:id="de4d9c55-ce12-47cc-be01-68bd9c15c80a" name="" supplier="6d7fa354-9f67-4b45-a957-a34f1d8ec3f5" client="90aed7c1-38e7-4248-836b-7d706016871d" contract="6d7fa354-9f67-4b45-a957-a34f1d8ec3f5"/>
