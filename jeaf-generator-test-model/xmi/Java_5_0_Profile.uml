          <packagedElement xmi:type="uml:Class" xmi:id="93f5dd0f-d95d-44e3-91da-1ae055375a3d" name="Canvas" clientDependency="3e245ab2-df80-47bd-b03f-10ce76db5b6f">
            <ownedComment xmi:id="70f69511-c080-485c-aa46-2acac350a467" body="A &lt;code>Canvas&lt;/code> component represents a blank rectangular&#xA;area of the screen onto which the application can draw or from&#xA;which the application can trap input events from the user.&#xA;&lt;p>&#xA;An application must subclass the &lt;code>Canvas&lt;/code> class in&#xA;order to get useful functionality such as creating a custom&#xA;component. The &lt;code>paint&lt;/code> method must be overridden&#xA;in order to perform custom graphics on the canvas.&#xA;&#xA;@version &#x9;1.35 03/16/04&#xA;@author &#x9;Sami Shaio&#xA;@since       JDK1.0&#xA;" annotatedElement="93f5dd0f-d95d-44e3-91da-1ae055375a3d"/>
            <generalization xmi:id="f903e321-6a5e-4133-9b59-4c79b0d81c7b" isSubstitutable="true" general="4d925b7b-d68e-4e13-b87b-98bdb93e9024"/>
            <interfaceRealization xmi:id="3e245ab2-df80-47bd-b03f-10ce76db5b6f" name="" supplier="ed907a69-6a73-461b-8000-495b37bdc076" client="93f5dd0f-d95d-44e3-91da-1ae055375a3d" contract="ed907a69-6a73-461b-8000-495b37bdc076"/>
            <nestedClassifier xmi:type="uml:Class" xmi:id="1e7d93d6-33f0-48ef-9d1e-394484ae4940" name="AccessibleAWTCanvas" visibility="protected">
