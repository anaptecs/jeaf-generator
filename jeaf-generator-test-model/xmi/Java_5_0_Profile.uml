                <ownedComment xmi:id="2c6bfea3-11b5-4130-87da-b516eec7c69f" body="Node class for a case sensitive sequence of literal characters.&#xA;" annotatedElement="55ee5be6-c169-4604-9177-3111905fac21"/>
                <generalization xmi:id="4698a1df-a6a5-4132-928e-2f97c592c3d5" isSubstitutable="true" general="e7901300-aa23-4b2f-88de-866200abe660"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="fc3bcdfa-2cb5-4e05-be2b-16fed1affe1f" name="SliceA" visibility="package" isLeaf="true">
                <ownedComment xmi:id="163649c4-d2d7-41b8-81dd-a4e60fd09c1e" body="Node class for a case insensitive sequence of literal characters.&#xA;" annotatedElement="fc3bcdfa-2cb5-4e05-be2b-16fed1affe1f"/>
                <generalization xmi:id="b43b28d1-e86e-48ae-86ca-c31c88d9c073" isSubstitutable="true" general="e7901300-aa23-4b2f-88de-866200abe660"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="2c5b9667-6de9-45f0-bd26-c782cb8f8ff4" name="SliceU" visibility="package" isLeaf="true">
                <ownedComment xmi:id="b8b90524-47ee-4252-af21-1a4b15a02d46" body="Node class for a case insensitive sequence of literal characters.&#xA;Uses unicode case folding.&#xA;" annotatedElement="2c5b9667-6de9-45f0-bd26-c782cb8f8ff4"/>
                <generalization xmi:id="46d0f7aa-91f6-4c44-9344-9d1c802d68a7" isSubstitutable="true" general="e7901300-aa23-4b2f-88de-866200abe660"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="cbbca13d-27af-49e2-bffd-ca0a348e97ec" name="Range" visibility="package">
                <ownedComment xmi:id="91eae61e-45ae-429c-8eb8-7f4ff2a4a439" body="Node class for matching characters within an explicit value range.&#xA;" annotatedElement="cbbca13d-27af-49e2-bffd-ca0a348e97ec"/>
                <generalization xmi:id="046665b1-a57d-45a7-ba2e-5257eeca26f2" isSubstitutable="true" general="e7901300-aa23-4b2f-88de-866200abe660"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="bb7945b7-3ef0-4823-a64a-310e181806da" name="CIRange" visibility="package" isLeaf="true">
                <ownedComment xmi:id="c2e120dc-8a83-4d5a-9dbf-c4d1b63d185d" body="Node class for matching characters within an explicit value range&#xA;in a case insensitive manner.&#xA;" annotatedElement="bb7945b7-3ef0-4823-a64a-310e181806da"/>
                <generalization xmi:id="c6717183-51d9-4e63-9f2b-e357eed6b43b" isSubstitutable="true" general="cbbca13d-27af-49e2-bffd-ca0a348e97ec"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="8eca9673-d91f-4f2b-b392-de3dc6f83050" name="NotRange" visibility="package">
                <generalization xmi:id="12ade0ec-42de-4799-90ff-ad99168a527e" isSubstitutable="true" general="e7901300-aa23-4b2f-88de-866200abe660"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="cb462e9f-9371-4e35-9ad7-321a325c88a8" name="CINotRange" visibility="package">
                <generalization xmi:id="5767fb15-a7b8-49e8-9d2d-62c2b9314223" isSubstitutable="true" general="8eca9673-d91f-4f2b-b392-de3dc6f83050"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="0b382e93-672c-4e77-b0a4-12396124d4c3" name="All" visibility="package" isLeaf="true">
                <ownedComment xmi:id="faab3297-52af-402d-bcba-9d909763c50c" body="Implements the Unicode category ALL and the dot metacharacter when&#xA;in dotall mode.&#xA;" annotatedElement="0b382e93-672c-4e77-b0a4-12396124d4c3"/>
                <generalization xmi:id="35f00af7-f940-4817-8965-f70b7b892d99" isSubstitutable="true" general="e7901300-aa23-4b2f-88de-866200abe660"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="8932fdad-4b24-4211-8c83-2ff59128c3fb" name="Dot" visibility="package" isLeaf="true">
                <ownedComment xmi:id="3bc5bec4-97f7-4778-8134-1159b7fdfdee" body="Node class for the dot metacharacter when dotall is not enabled.&#xA;" annotatedElement="8932fdad-4b24-4211-8c83-2ff59128c3fb"/>
                <generalization xmi:id="ede21226-c4d5-4c38-88a8-bc9afd0a3c8b" isSubstitutable="true" general="e7901300-aa23-4b2f-88de-866200abe660"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="6d368d74-5512-411d-94f3-93d212cba8f0" name="UnixDot" visibility="package" isLeaf="true">
                <ownedComment xmi:id="6f6c0abc-a855-4a8b-8e62-56383afbda43" body="Node class for the dot metacharacter when dotall is not enabled&#xA;but UNIX_LINES is enabled.&#xA;" annotatedElement="6d368d74-5512-411d-94f3-93d212cba8f0"/>
                <generalization xmi:id="3b04fac4-4e39-4a5d-a7ae-3547e18c80a2" isSubstitutable="true" general="e7901300-aa23-4b2f-88de-866200abe660"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="5538cd4c-2b75-488a-a0d4-b9464bf23ab9" name="Ques" visibility="package" isLeaf="true">
                <ownedComment xmi:id="c2f58ae7-bc2e-49c1-9b2b-fc98003b802d" body="The 0 or 1 quantifier. This one class implements all three types.&#xA;" annotatedElement="5538cd4c-2b75-488a-a0d4-b9464bf23ab9"/>
                <generalization xmi:id="21755c55-6752-44ce-aab3-b28f91bb7fe4" isSubstitutable="true" general="e7901300-aa23-4b2f-88de-866200abe660"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="6884d044-9dc6-4c0c-b0aa-236e4f66707b" name="Curly" visibility="package" isLeaf="true">
                <ownedComment xmi:id="e0b48279-05dc-4b23-8fdb-7a32dbf8fa01" body="Handles the curly-brace style repetition with a specified minimum and&#xA;maximum occurrences. The * quantifier is handled as a special case.&#xA;This class handles the three types.&#xA;" annotatedElement="6884d044-9dc6-4c0c-b0aa-236e4f66707b"/>
                <generalization xmi:id="5ed4590c-96f5-4966-8c37-a1d812f59c49" isSubstitutable="true" general="e7901300-aa23-4b2f-88de-866200abe660"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="ea4102dc-4e85-47e1-ac12-3e3ff26b56ee" name="GroupCurly" visibility="package" isLeaf="true">
                <ownedComment xmi:id="a98cb55f-05a8-4031-b247-f867efc2173c" body="Handles the curly-brace style repetition with a specified minimum and&#xA;maximum occurrences in deterministic cases. This is an iterative&#xA;optimization over the Prolog and Loop system which would handle this&#xA;in a recursive way. The * quantifier is handled as a special case.&#xA;If capture is true then this class saves group settings and ensures&#xA;that groups are unset when backing off of a group match.&#xA;" annotatedElement="ea4102dc-4e85-47e1-ac12-3e3ff26b56ee"/>
                <generalization xmi:id="de986279-7546-4194-acfd-7a643adc48ad" isSubstitutable="true" general="e7901300-aa23-4b2f-88de-866200abe660"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="0ca85539-de78-4766-a960-40901f0ed20d" name="Branch" visibility="package" isLeaf="true">
                <ownedComment xmi:id="8b5f4635-1fd1-43b8-a20c-73b4b06b11fc" body="Handles the branching of alternations. Note this is also used for&#xA;the ? quantifier to branch between the case where it matches once&#xA;and where it does not occur.&#xA;" annotatedElement="0ca85539-de78-4766-a960-40901f0ed20d"/>
                <generalization xmi:id="170d33c7-e647-4869-b2a4-89aa0c1312d8" isSubstitutable="true" general="e7901300-aa23-4b2f-88de-866200abe660"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="f7b0902c-9fc6-4e4c-baaa-9fb16f587bbe" name="GroupHead" visibility="package" isLeaf="true">
                <ownedComment xmi:id="d2a342f2-4b16-464b-a5b1-f7d6f0194cb1" body="The GroupHead saves the location where the group begins in the locals&#xA;and restores them when the match is done.&#xA;&#xA;The matchRef is used when a reference to this group is accessed later&#xA;in the expression. The locals will have a negative value in them to&#xA;indicate that we do not want to unset the group if the reference&#xA;doesn't match.&#xA;" annotatedElement="f7b0902c-9fc6-4e4c-baaa-9fb16f587bbe"/>
                <generalization xmi:id="4293beb8-7d5c-4ddb-ad75-ee0d0109e7b2" isSubstitutable="true" general="e7901300-aa23-4b2f-88de-866200abe660"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="ea9a7a41-03c9-47f9-8851-88d36f87021a" name="GroupRef" visibility="package" isLeaf="true">
                <ownedComment xmi:id="82f951c0-4220-45fa-a2b1-2abe937e548b" body="Recursive reference to a group in the regular expression. It calls&#xA;matchRef because if the reference fails to match we would not unset&#xA;the group.&#xA;" annotatedElement="ea9a7a41-03c9-47f9-8851-88d36f87021a"/>
                <generalization xmi:id="0e3b3abb-63cd-45af-b27e-d8736792fd49" isSubstitutable="true" general="e7901300-aa23-4b2f-88de-866200abe660"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="3434740e-509a-4f7c-8414-9ace88f3d4d7" name="GroupTail" visibility="package" isLeaf="true">
                <ownedComment xmi:id="0ce68318-efaf-48a0-893b-8b03e282893d" body="The GroupTail handles the setting of group beginning and ending&#xA;locations when groups are successfully matched. It must also be able to&#xA;unset groups that have to be backed off of.&#xA;&#xA;The GroupTail node is also used when a previous group is referenced,&#xA;and in that case no group information needs to be set.&#xA;" annotatedElement="3434740e-509a-4f7c-8414-9ace88f3d4d7"/>
                <generalization xmi:id="547caef1-d87a-43a1-9ec0-e19c6cb9d018" isSubstitutable="true" general="e7901300-aa23-4b2f-88de-866200abe660"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="60f30679-cc8e-403c-b20c-e3f8cc2a9442" name="Prolog" visibility="package" isLeaf="true">
                <ownedComment xmi:id="1de3f625-4091-4e84-8c70-f627db5f48c4" body="This sets up a loop to handle a recursive quantifier structure.&#xA;" annotatedElement="60f30679-cc8e-403c-b20c-e3f8cc2a9442"/>
                <generalization xmi:id="fb7056c8-6f3e-454b-9ab2-d06812c785b1" isSubstitutable="true" general="e7901300-aa23-4b2f-88de-866200abe660"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="c2e5e31c-b7f4-439e-ba95-cca293c1d4a1" name="Loop" visibility="package">
                <ownedComment xmi:id="0ee2f61a-028b-427e-9a1f-b40c1f023644" body="Handles the repetition count for a greedy Curly. The matchInit&#xA;is called from the Prolog to save the index of where the group&#xA;beginning is stored. A zero length group check occurs in the&#xA;normal match but is skipped in the matchInit.&#xA;" annotatedElement="c2e5e31c-b7f4-439e-ba95-cca293c1d4a1"/>
                <generalization xmi:id="73946f0d-7f5f-463f-9354-ae11d9e54b99" isSubstitutable="true" general="e7901300-aa23-4b2f-88de-866200abe660"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="38993261-a14e-4029-9382-d847b326c1bf" name="LazyLoop" visibility="package" isLeaf="true">
                <ownedComment xmi:id="01971eea-6927-41d0-a046-a920cb31ec14" body="Handles the repetition count for a reluctant Curly. The matchInit&#xA;is called from the Prolog to save the index of where the group&#xA;beginning is stored. A zero length group check occurs in the&#xA;normal match but is skipped in the matchInit.&#xA;" annotatedElement="38993261-a14e-4029-9382-d847b326c1bf"/>
                <generalization xmi:id="f7da9d3a-6f9d-4591-a50b-972d64525a7a" isSubstitutable="true" general="c2e5e31c-b7f4-439e-ba95-cca293c1d4a1"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="cc8c7756-b60e-4356-a512-958fe93995d7" name="BackRef" visibility="package">
                <ownedComment xmi:id="1a86dfd3-2f3e-4d2d-895d-f04ba8be5855" body="Refers to a group in the regular expression. Attempts to match&#xA;whatever the group referred to last matched.&#xA;" annotatedElement="cc8c7756-b60e-4356-a512-958fe93995d7"/>
                <generalization xmi:id="f5482ad2-8e54-4680-a200-cc60c658408f" isSubstitutable="true" general="e7901300-aa23-4b2f-88de-866200abe660"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="360e847c-7700-4ed4-a88c-2e64a9f368e9" name="CIBackRef" visibility="package">
                <generalization xmi:id="9894a9cf-95a6-4f28-82c2-c7b211ed1837" isSubstitutable="true" general="e7901300-aa23-4b2f-88de-866200abe660"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="58c2d679-4e51-4d14-a423-527c985f5b42" name="First" visibility="package" isLeaf="true">
                <ownedComment xmi:id="6a0b9277-56a7-4520-8eb2-820b5fdcf8b1" body="Searches until the next instance of its atom. This is useful for&#xA;finding the atom efficiently without passing an instance of it&#xA;(greedy problem) and without a lot of wasted search time (reluctant&#xA;problem).&#xA;" annotatedElement="58c2d679-4e51-4d14-a423-527c985f5b42"/>
                <generalization xmi:id="49957dbb-82d0-4f3e-adda-52fd02a91a96" isSubstitutable="true" general="e7901300-aa23-4b2f-88de-866200abe660"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="c09cdc39-c140-47dd-868f-a085e8f2c521" name="Conditional" visibility="package" isLeaf="true">
                <generalization xmi:id="07b1ea31-5b0a-4ac8-9551-adcc58e2f7f0" isSubstitutable="true" general="e7901300-aa23-4b2f-88de-866200abe660"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="f542cb36-8e61-4ae9-87c0-1a9c5cef5db2" name="Pos" visibility="package" isLeaf="true">
                <ownedComment xmi:id="a78d303d-cf6e-4e02-9d7f-d03e6a09437c" body="Zero width positive lookahead.&#xA;" annotatedElement="f542cb36-8e61-4ae9-87c0-1a9c5cef5db2"/>
                <generalization xmi:id="4d0f6b36-296f-4479-a638-0cbdf044c2fb" isSubstitutable="true" general="e7901300-aa23-4b2f-88de-866200abe660"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="6bf1ac29-7bcc-4c93-98ea-b82e856ac95d" name="Neg" visibility="package" isLeaf="true">
                <ownedComment xmi:id="165ab364-2669-41aa-aca0-52b76a1ad50c" body="Zero width negative lookahead.&#xA;" annotatedElement="6bf1ac29-7bcc-4c93-98ea-b82e856ac95d"/>
                <generalization xmi:id="b53eca10-e978-4bf1-810a-9d917aca56b8" isSubstitutable="true" general="e7901300-aa23-4b2f-88de-866200abe660"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="1a919a6b-e8a5-4004-b94b-3ca0b142082a" name="Behind" visibility="package">
                <ownedComment xmi:id="2883d7da-6405-40a9-9373-e4cced812dcb" body="Zero width positive lookbehind.&#xA;" annotatedElement="1a919a6b-e8a5-4004-b94b-3ca0b142082a"/>
                <generalization xmi:id="7614c2d4-5eab-4264-885d-88f6919b3873" isSubstitutable="true" general="e7901300-aa23-4b2f-88de-866200abe660"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="ea07a90f-27e3-4886-9154-78bbded56aec" name="NotBehind" visibility="package">
                <ownedComment xmi:id="6b1980cb-c1f6-462e-9744-e4b66c53792f" body="Zero width negative lookbehind.&#xA;" annotatedElement="ea07a90f-27e3-4886-9154-78bbded56aec"/>
                <generalization xmi:id="7986d3cf-6c5a-4770-a291-c5ff98c5160e" isSubstitutable="true" general="e7901300-aa23-4b2f-88de-866200abe660"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="50683fac-8fe5-4036-957f-500a11b36f0d" name="Add" visibility="package">
                <ownedComment xmi:id="6a3872c4-5b82-4c49-afba-1bc5c3e3b7ad" body="An object added to the tree when a character class has an additional&#xA;range added to it.&#xA;" annotatedElement="50683fac-8fe5-4036-957f-500a11b36f0d"/>
                <generalization xmi:id="8b7b2c1e-14a0-4059-924f-593dfb64058f" isSubstitutable="true" general="e7901300-aa23-4b2f-88de-866200abe660"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="0d354d80-c40c-44cf-b47b-6875459eb6f4" name="Both" visibility="package">
                <ownedComment xmi:id="4f90defa-533b-4675-a38e-f6ca51d30fac" body="An object added to the tree when a character class has another&#xA;nested class in it.&#xA;" annotatedElement="0d354d80-c40c-44cf-b47b-6875459eb6f4"/>
                <generalization xmi:id="1348b05f-66de-4b8a-8ff0-2fd279ae7b93" isSubstitutable="true" general="e7901300-aa23-4b2f-88de-866200abe660"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="baf4a94b-0d52-4f98-b860-63f94824d881" name="Sub" visibility="package" isLeaf="true">
                <ownedComment xmi:id="d24226d4-5ecb-44f4-9d41-aeca66b546fd" body="An object added to the tree when a character class has a range&#xA;or single subtracted from it.&#xA;" annotatedElement="baf4a94b-0d52-4f98-b860-63f94824d881"/>
                <generalization xmi:id="ba331373-e454-48ed-bb99-b6874fc53884" isSubstitutable="true" general="50683fac-8fe5-4036-957f-500a11b36f0d"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="f823513b-9129-4fcf-9298-2138405aa5f1" name="Bound" visibility="package" isLeaf="true">
                <ownedComment xmi:id="72e24452-fa46-4113-a62b-762ce7fddf0e" body="Handles word boundaries. Includes a field to allow this one class to&#xA;deal with the different types of word boundaries we can match. The word&#xA;characters include underscores, letters, and digits. Non spacing marks&#xA;can are also part of a word if they have a base character, otherwise&#xA;they are ignored for purposes of finding word boundaries.&#xA;" annotatedElement="f823513b-9129-4fcf-9298-2138405aa5f1"/>
                <generalization xmi:id="e0dd54a7-f7d3-47c4-a449-3242ae87783b" isSubstitutable="true" general="e7901300-aa23-4b2f-88de-866200abe660"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="c469c1d6-146f-45a1-a9f4-fdb261ec493f" name="BnM" visibility="package">
                <ownedComment xmi:id="c2758162-e07d-456a-89b1-5b86fc382a30" body="Attempts to match a slice in the input using the Boyer-Moore string&#xA;matching algorithm. The algorithm is based on the idea that the&#xA;pattern can be shifted farther ahead in the search text if it is&#xA;matched right to left.&#xA;&lt;p>&#xA;The pattern is compared to the input one character at a time, from&#xA;the rightmost character in the pattern to the left. If the characters&#xA;all match the pattern has been found. If a character does not match,&#xA;the pattern is shifted right a distance that is the maximum of two&#xA;functions, the bad character shift and the good suffix shift. This&#xA;shift moves the attempted match position through the input more&#xA;quickly than a naive one position at a time check.&#xA;&lt;p>&#xA;The bad character shift is based on the character from the text that&#xA;did not match. If the character does not appear in the pattern, the&#xA;pattern can be shifted completely beyond the bad character. If the&#xA;character does occur in the pattern, the pattern can be shifted to&#xA;line the pattern up with the next occurrence of that character.&#xA;&lt;p>&#xA;The good suffix shift is based on the idea that some subset on the right&#xA;side of the pattern has matched. When a bad character is found, the&#xA;pattern can be shifted right by the pattern length if the subset does&#xA;not occur again in pattern, or by the amount of distance to the&#xA;next occurrence of the subset in the pattern.&#xA;&#xA;Boyer-Moore search methods adapted from code by Amy Yu.&#xA;" annotatedElement="c469c1d6-146f-45a1-a9f4-fdb261ec493f"/>
                <generalization xmi:id="041545b0-ed35-404e-9708-5aa5ab9de19b" isSubstitutable="true" general="e7901300-aa23-4b2f-88de-866200abe660"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="b6042c57-9030-462c-8371-99833bfd3889" name="StartS" visibility="package" isLeaf="true">
                <generalization xmi:id="6ad8488c-01e2-445a-9724-ca755376098a" isSubstitutable="true" general="96a276d5-a3a1-42f2-9d62-db9b61e33eeb"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="8bda78f5-6b34-4ea2-aff1-6ee10487eae2" name="JavaTypeClass" visibility="package" isAbstract="true">
                <generalization xmi:id="6786d539-221b-4e00-8f34-a37e0a32f60c" isSubstitutable="true" general="e7901300-aa23-4b2f-88de-866200abe660"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="303ea723-665b-40fe-a010-0aea0685b5b0" name="JavaLowerCase" visibility="package" isLeaf="true">
                <generalization xmi:id="5dcf5995-a765-4c59-9892-b37e20aa33a3" isSubstitutable="true" general="8bda78f5-6b34-4ea2-aff1-6ee10487eae2"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="70592c94-9650-4d16-9de5-2bfd09d78bbc" name="JavaUpperCase" visibility="package" isLeaf="true">
                <generalization xmi:id="052d10cf-b191-430c-973e-8b55bba3c992" isSubstitutable="true" general="8bda78f5-6b34-4ea2-aff1-6ee10487eae2"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="8ee6a459-fe0f-4574-bb78-1eff1b237306" name="JavaTitleCase" visibility="package" isLeaf="true">
                <generalization xmi:id="8ed10da5-7b71-4f47-b493-e58cddb578c7" isSubstitutable="true" general="8bda78f5-6b34-4ea2-aff1-6ee10487eae2"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="b3adea12-e5d6-4a5d-9066-49daa7851757" name="JavaDigit" visibility="package" isLeaf="true">
                <generalization xmi:id="1b4cfb9a-ec53-4022-8a79-a1d1ae709e9e" isSubstitutable="true" general="8bda78f5-6b34-4ea2-aff1-6ee10487eae2"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="239b0236-6de3-4f7b-adea-cd6b1cb68cc8" name="JavaDefined" visibility="package" isLeaf="true">
                <generalization xmi:id="74a723c4-2ed9-42f0-8ac2-833fe078c9a0" isSubstitutable="true" general="8bda78f5-6b34-4ea2-aff1-6ee10487eae2"/>
