                  <ownedComment xmi:id="25e2924d-6049-4925-aca8-d8bcbe66f7a5" body="An Enumeration of the Attribute names in a MuxingAttributeSet.&#xA;This may return the same name more than once.&#xA;" annotatedElement="b659d589-c02a-429d-b87d-694bdca175ae"/>
                  <interfaceRealization xmi:id="ad70ef76-e55c-4c28-98a2-d1d3f0971791" name="" supplier="9e9adaa7-1ac1-4cd9-89db-7b98e385abf9" client="b659d589-c02a-429d-b87d-694bdca175ae" contract="9e9adaa7-1ac1-4cd9-89db-7b98e385abf9"/>
                </nestedClassifier>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="df0e5570-2a55-433e-a273-6d72ac56a4ea" name="Option">
                <ownedComment xmi:id="31cee080-2815-45f6-8272-b7fea1cc31f9" body="Value for the ListModel used to represent&#xA;&lt;option> elements.  This is the object&#xA;installed as items of the DefaultComboBoxModel&#xA;used to represent the &lt;select> element.&#xA;&#xA;@author  Timothy Prinzing&#xA;@version 1.10 12/19/03&#xA;" annotatedElement="df0e5570-2a55-433e-a273-6d72ac56a4ea"/>
