            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="d403e59b-25c2-47a4-8ee2-e5da314045e6" name="DSAPrivateKey" isAbstract="true">
              <ownedComment xmi:id="fa475644-2f88-4e18-b46b-87fad01d1dcf" body="The standard interface to a DSA private key. DSA (Digital Signature&#xA;Algorithm) is defined in NIST's FIPS-186.&#xA;&#xA;@see java.security.Key&#xA;@see java.security.Signature&#xA;@see DSAKey&#xA;@see DSAPublicKey&#xA;&#xA;@version 1.19 03/12/19&#xA;@author Benjamin Renaud&#xA;" annotatedElement="d403e59b-25c2-47a4-8ee2-e5da314045e6"/>
              <generalization xmi:id="57db8ecf-b2fc-4f5f-944a-5a71a7e92830" isSubstitutable="true" general="92fa8aeb-50cf-4d86-9a22-26112aacedff"/>
              <generalization xmi:id="18adc004-2a5b-4378-890a-1b3ce283eca0" isSubstitutable="true" general="a47b3e4b-5618-401f-a098-d0490c80d17e"/>
