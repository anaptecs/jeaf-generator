              <nestedClassifier xmi:type="uml:Class" xmi:id="02d796a2-2348-41fa-b078-9320b67ac67a" name="Category" visibility="package" isLeaf="true">
                <ownedComment xmi:id="c72b660a-854b-4e08-98ca-458e2711200a" body="Node class that matches a Unicode category.&#xA;" annotatedElement="02d796a2-2348-41fa-b078-9320b67ac67a"/>
                <generalization xmi:id="1d40cb0d-2dfb-4392-845c-8a7411683d54" isSubstitutable="true" general="e7901300-aa23-4b2f-88de-866200abe660"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="cc88015a-d31d-48e3-967a-5c20645352a3" name="Ctype" visibility="package" isLeaf="true">
                <ownedComment xmi:id="160be962-6b1c-4448-b5f8-1e130f855048" body="Node class that matches a POSIX type.&#xA;" annotatedElement="cc88015a-d31d-48e3-967a-5c20645352a3"/>
                <generalization xmi:id="46f79419-95f0-4dd9-aa89-8b49df13a6d0" isSubstitutable="true" general="e7901300-aa23-4b2f-88de-866200abe660"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="42681edd-be0f-42f0-a8be-ae2e07ebe6b9" name="NotCtype" visibility="package" isLeaf="true">
                <generalization xmi:id="2a929f79-1926-4439-93a8-5e4fb1b48141" isSubstitutable="true" general="e7901300-aa23-4b2f-88de-866200abe660"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="555d083a-5455-4e7d-8967-1c31804cc269" name="Specials" visibility="package" isLeaf="true">
                <generalization xmi:id="1996fbc8-2399-408a-bfe2-1eed900c9fe1" isSubstitutable="true" general="e7901300-aa23-4b2f-88de-866200abe660"/>
              </nestedClassifier>
