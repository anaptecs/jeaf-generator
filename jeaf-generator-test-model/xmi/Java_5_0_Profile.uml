            <packagedElement xmi:type="uml:Interface" xmi:id="2b1a65d1-7eb5-41c3-b2df-76235fd0088a" name="PreferenceChangeListener" isAbstract="true">
              <ownedComment xmi:id="aa86f146-d13c-4122-ac2c-178c3a5dfee5" body="A listener for receiving preference change events.&#xA;&#xA;@author  Josh Bloch&#xA;@version 1.4, 12/19/03&#xA;@see Preferences&#xA;@see PreferenceChangeEvent&#xA;@see NodeChangeListener&#xA;@since   1.4&#xA;" annotatedElement="2b1a65d1-7eb5-41c3-b2df-76235fd0088a"/>
