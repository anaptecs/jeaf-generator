                <ownedComment xmi:id="cc4f291b-3dbd-4672-90b2-6e2be362f868" body="Default drag gesture recognition for drag operations performed by classses&#xA;that have a &lt;code>dragEnabled&lt;/code> property.  The gesture for a drag in&#xA;this package is a mouse press over a selection followed by some movement&#xA;by enough pixels to keep it from being treated as a click.&#xA;&#xA;@author  Timothy Prinzing&#xA;@version 1.7 12/19/03&#xA;" annotatedElement="602f8cf7-2456-4c0f-adf7-4b948b620265"/>
                <interfaceRealization xmi:id="752115d1-05c0-4f7c-8ee9-b9181c82afee" name="" supplier="d2bfccf2-94c5-4882-8d84-613f4ad53195" client="602f8cf7-2456-4c0f-adf7-4b948b620265" contract="d2bfccf2-94c5-4882-8d84-613f4ad53195"/>
