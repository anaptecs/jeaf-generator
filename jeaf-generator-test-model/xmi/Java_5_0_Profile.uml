          <packagedElement xmi:type="uml:Class" xmi:id="552f7f23-1ee3-4222-89fc-39e7cfd3d8a7" name="ProcessImpl" visibility="package" isLeaf="true">
            <generalization xmi:id="eb2fecd9-9165-4095-b4d8-d2e1014e3e5b" isSubstitutable="true" general="73f38a63-ea3f-414b-9fe4-6cd53ec01bca"/>
