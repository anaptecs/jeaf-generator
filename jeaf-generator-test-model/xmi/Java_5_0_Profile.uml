              <nestedClassifier xmi:type="uml:Class" xmi:id="b3c0213b-5de2-4b8b-8973-276db1472be9" name="Handler" visibility="package" clientDependency="3056654e-2594-4adb-9704-ac26aa9c8e66 fa024356-1f98-4fb3-a3c0-96038fa78fe1 f48cef6b-48a0-4800-a8e4-8c7ef0e724c6 998f4325-76b1-4f77-8bfc-c47be9da0910">
                <interfaceRealization xmi:id="fa024356-1f98-4fb3-a3c0-96038fa78fe1" name="" supplier="b548bd16-341a-4f73-88bd-d65014ec5997" client="b3c0213b-5de2-4b8b-8973-276db1472be9" contract="b548bd16-341a-4f73-88bd-d65014ec5997"/>
                <interfaceRealization xmi:id="998f4325-76b1-4f77-8bfc-c47be9da0910" name="" supplier="8473483d-b350-428d-828b-a5a719abea43" client="b3c0213b-5de2-4b8b-8973-276db1472be9" contract="8473483d-b350-428d-828b-a5a719abea43"/>
                <interfaceRealization xmi:id="f48cef6b-48a0-4800-a8e4-8c7ef0e724c6" name="" supplier="881e1f63-ea05-4933-82ba-17d8d70f9be1" client="b3c0213b-5de2-4b8b-8973-276db1472be9" contract="881e1f63-ea05-4933-82ba-17d8d70f9be1"/>
                <interfaceRealization xmi:id="3056654e-2594-4adb-9704-ac26aa9c8e66" name="" supplier="63638b0c-847b-4f43-9375-9eefaae00afa" client="b3c0213b-5de2-4b8b-8973-276db1472be9" contract="63638b0c-847b-4f43-9375-9eefaae00afa"/>
