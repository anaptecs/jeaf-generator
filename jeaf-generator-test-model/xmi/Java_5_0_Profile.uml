                <interfaceRealization xmi:id="5bc8d60c-678d-4903-bd88-32477696d293" name="" supplier="96291d1f-c8b1-4d93-be2c-623c9dbcb046" client="1f731398-956d-4387-a1ab-480f695adcef" contract="96291d1f-c8b1-4d93-be2c-623c9dbcb046"/>
