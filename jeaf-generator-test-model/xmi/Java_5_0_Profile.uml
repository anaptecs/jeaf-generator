              <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="505be018-f236-4304-8ac8-a0fdddbac921" name="" parameter="669823c5-d059-4a19-aac5-b21acfeeda9b 3673662f-2310-419f-bd54-521f9d9fff79">
