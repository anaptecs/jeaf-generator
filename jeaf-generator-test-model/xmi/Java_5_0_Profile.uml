                <ownedComment xmi:id="875a86ea-1784-4cef-9673-425b91c72820" body="A Basic L&amp;F implementation of ToolBarSeparatorUI.  This implementation&#xA;is a &quot;combined&quot; view/controller.&#xA;&lt;p>&#xA;&#xA;@version 1.13 12/19/03&#xA;@author Jeff Shapiro&#xA;" annotatedElement="c86408d0-50fe-41de-8e06-0102217d6abe"/>
