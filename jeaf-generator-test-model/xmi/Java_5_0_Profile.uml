              <nestedClassifier xmi:type="uml:Class" xmi:id="b1a9190a-4ef1-40f7-bf56-4122b19dcf1a" name="EntryIterator" visibility="package" clientDependency="28bf8653-a236-4978-97bb-432171822078 c229b20c-8539-443d-a5e2-7e42f9067679 3963f89d-cd0d-4464-be44-efe679463e14" isLeaf="true">
                <ownedComment xmi:id="efcb3f34-0945-474c-9ad1-5736f3da79e5" body="Entry iterator. Exported Entry objects must write-through&#xA;changes in setValue, even if the nodes have been cloned. So we&#xA;cannot return internal HashEntry objects. Instead, the iterator&#xA;itself acts as a forwarding pseudo-entry.&#xA;" annotatedElement="b1a9190a-4ef1-40f7-bf56-4122b19dcf1a"/>
