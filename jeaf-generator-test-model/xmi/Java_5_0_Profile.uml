          <packagedElement xmi:type="uml:Interface" xmi:id="329872e3-8fdd-4f5a-9229-28884b051e42" name="Comparator&lt;Comparable&lt;Object>>">
            <templateBinding xmi:id="e0e94ed5-95ea-423f-bbcb-8414d47fc0c5" signature="5ca0174c-f6a2-499c-8047-b28b014e167d">
