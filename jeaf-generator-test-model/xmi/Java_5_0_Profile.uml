          <packagedElement xmi:type="uml:Class" xmi:id="49e616a3-ae12-450b-a151-207e17c439c2" name="ComponentInputMap">
            <ownedComment xmi:id="5f9ddbd4-5c58-4404-ac92-70e1c5f0238a" body="A &lt;code>ComponentInputMap&lt;/code> is an &lt;code>InputMap&lt;/code>&#xA;associated with a particular &lt;code>JComponent&lt;/code>.&#xA;The component is automatically notified whenever&#xA;the &lt;code>ComponentInputMap&lt;/code> changes.&#xA;&lt;code>ComponentInputMap&lt;/code>s are used for&#xA;&lt;code>WHEN_IN_FOCUSED_WINDOW&lt;/code> bindings.&#xA;&#xA;@version 1.9 12/19/03&#xA;@author Scott Violet&#xA;" annotatedElement="49e616a3-ae12-450b-a151-207e17c439c2"/>
