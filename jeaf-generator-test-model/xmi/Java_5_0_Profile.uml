              <interfaceRealization xmi:id="2073af1b-b0ac-4e0b-b35d-5a4245ef92ff" name="" supplier="56bf6aa5-263a-4a52-8bf0-175f4238b77e" client="99fa2dcf-8ef3-4c52-a88a-a6ebb9d2ac6e" contract="56bf6aa5-263a-4a52-8bf0-175f4238b77e"/>
              <nestedClassifier xmi:type="uml:Class" xmi:id="8d6fb04e-3b2e-44b4-8b6f-b91fc6d41228" name="COWIterator" visibility="private" clientDependency="13c743bc-6ae0-4a48-9d6c-02128d739f87">
                <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="ebc3655e-f705-45f4-b496-896fcede4cc5" name="" parameter="8ce5efdb-3b20-466c-b379-ed497d3a8a0e">
