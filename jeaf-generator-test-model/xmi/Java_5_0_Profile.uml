            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="b789d965-f9a5-473b-b133-d0caf112f70f" name="BeanContextChildSupport" clientDependency="818ca46c-dd48-451a-aace-aaf4171ce9c7 208e3a0b-945a-4fcf-b4f2-d2238fbf9463 62af4248-f528-492d-a78c-81a7f63f92b6">
              <ownedComment xmi:id="f12cd06f-d5ac-4bbe-92d6-1e43f13fa1be" body="&lt;p>&#xA;This is a general support class to provide support for implementing the&#xA;BeanContextChild protocol.&#xA;&#xA;This class may either be directly subclassed, or encapsulated and delegated&#xA;to in order to implement this interface for a given component.&#xA;&lt;/p>&#xA;&#xA;@author&#x9;Laurence P. G. Cable&#xA;@version&#x9;1.16, 03/04/04&#xA;@since&#x9;1.2&#xA;&#xA;@see&#x9;java.beans.beancontext.BeanContext&#xA;@see&#x9;java.beans.beancontext.BeanContextServices&#xA;@see&#x9;java.beans.beancontext.BeanContextChild&#xA;" annotatedElement="b789d965-f9a5-473b-b133-d0caf112f70f"/>
              <interfaceRealization xmi:id="208e3a0b-945a-4fcf-b4f2-d2238fbf9463" name="" supplier="4bee3929-bdd9-4435-a8c4-ca74892313f7" client="b789d965-f9a5-473b-b133-d0caf112f70f" contract="4bee3929-bdd9-4435-a8c4-ca74892313f7"/>
