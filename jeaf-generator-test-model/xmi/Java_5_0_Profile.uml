                  <nestedClassifier xmi:type="uml:Class" xmi:id="43c4899a-a749-437d-8e3f-46d7c8758389" name="TextTransferable" visibility="package">
                    <ownedComment xmi:id="542762c1-0e19-4d9d-8565-bbbc0c3e7754" body="A possible implementation of the Transferable interface&#xA;for text components.  For a JEditorPane with a rich set&#xA;of EditorKit implementations, conversions could be made&#xA;giving a wider set of formats.  This is implemented to&#xA;offer up only the active content type and text/plain&#xA;(if that is not the active format) since that can be&#xA;extracted from other formats.&#xA;" annotatedElement="43c4899a-a749-437d-8e3f-46d7c8758389"/>
                    <generalization xmi:id="3a12257d-e4e1-4988-9e9a-9abcd4390ec1" isSubstitutable="true" general="6af9ec7c-a503-4cd7-a4c3-1ce52e789003"/>
                  </nestedClassifier>
                </nestedClassifier>
