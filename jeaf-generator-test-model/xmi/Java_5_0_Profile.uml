                <ownedComment xmi:id="cba2606f-30da-402e-a1c0-2feea23da577" body="subclasses may subclass this nested class to add behaviors for&#xA;each BeanContextServicesProvider.&#xA;" annotatedElement="a7caf1c9-3e65-446f-a627-00a61b695e44"/>
