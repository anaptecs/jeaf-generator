                  <generalization xmi:id="3f7ce110-2eef-4ca2-b718-f2d21a780c5a" isSubstitutable="true" general="a5f3b498-3bea-4e43-ab3c-2affbc3dd30a"/>
                </nestedClassifier>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="043294bb-b946-42c7-91a8-c24580af50ce" name="AtomicLongArray" clientDependency="4a507ec0-94f2-495f-a1d3-6b451da02bc4">
                <ownedComment xmi:id="19c95aa4-ff62-43fa-89a5-80dbc9751ad5" body="A &lt;tt>long&lt;/tt> array in which elements may be updated atomically.&#xA;See the {@link java.util.concurrent.atomic} package specification&#xA;for description of the properties of atomic variables.&#xA;@since 1.5&#xA;@author Doug Lea&#xA;" annotatedElement="043294bb-b946-42c7-91a8-c24580af50ce"/>
                <interfaceRealization xmi:id="4a507ec0-94f2-495f-a1d3-6b451da02bc4" name="" supplier="56bf6aa5-263a-4a52-8bf0-175f4238b77e" client="043294bb-b946-42c7-91a8-c24580af50ce" contract="56bf6aa5-263a-4a52-8bf0-175f4238b77e"/>
              </packagedElement>
              <packagedElement xmi:type="uml:Class" xmi:id="a5f3b498-3bea-4e43-ab3c-2affbc3dd30a" name="AtomicReferenceFieldUpdater&lt;T, V>">
