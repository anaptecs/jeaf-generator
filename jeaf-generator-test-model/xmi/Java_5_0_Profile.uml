                <nestedClassifier xmi:type="uml:Class" xmi:id="39af6664-d397-4554-8fea-d17a9effd808" name="BasicPopupMenuListener" visibility="private" clientDependency="7a22cd91-9a6b-4901-871f-1e2d38bc162d">
                  <ownedComment xmi:id="196c5a6d-48fa-4c4e-b623-413164cf8e7f" body="This Listener fires the Action that provides the correct auditory&#xA;feedback.&#xA;&#xA;@since 1.4&#xA;" annotatedElement="39af6664-d397-4554-8fea-d17a9effd808"/>
