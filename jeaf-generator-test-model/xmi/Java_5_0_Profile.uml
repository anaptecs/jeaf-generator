          <packagedElement xmi:type="uml:Class" xmi:id="8f842ed0-8c58-4488-b621-794a994fc822" name="SocketImpl" clientDependency="00b20d2c-4317-47f9-ab01-a61e27cf919a" isAbstract="true">
            <ownedComment xmi:id="f10aa97d-85de-436c-a881-7cd51f8f1850" body="The abstract class &lt;code>SocketImpl&lt;/code> is a common superclass&#xA;of all classes that actually implement sockets. It is used to&#xA;create both client and server sockets.&#xA;&lt;p>&#xA;A &quot;plain&quot; socket implements these methods exactly as&#xA;described, without attempting to go through a firewall or proxy.&#xA;&#xA;@author  unascribed&#xA;@version 1.42, 03/25/04&#xA;@since   JDK1.0&#xA;" annotatedElement="8f842ed0-8c58-4488-b621-794a994fc822"/>
