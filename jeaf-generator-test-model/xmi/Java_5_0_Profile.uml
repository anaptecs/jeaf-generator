          <packagedElement xmi:type="uml:Interface" xmi:id="73ed3736-eaaf-4918-ae6e-b535e2517920" name="Deprecated" isAbstract="true">
            <ownedComment xmi:id="93084d06-c879-4e0a-a4be-c1fa7513ce7a" body="A program element annotated &amp;#64;Deprecated is one that programmers&#xA;are discouraged from using, typically because it is dangerous,&#xA;or because a better alternative exists.  Compilers warn when a&#xA;deprecated program element is used or overridden in non-deprecated code.&#xA;&#xA;@author  Neal Gafter&#xA;@version 1.4, 06/10/04&#xA;@since 1.5&#xA;" annotatedElement="73ed3736-eaaf-4918-ae6e-b535e2517920"/>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="6aa46dbe-7251-4b26-90ad-852964584f94" name="AbstractSet&lt;Entry&lt;String, String>>">
