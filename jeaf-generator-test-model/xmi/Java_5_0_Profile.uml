            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="fab524f7-59eb-4ace-bf91-fd1feeef80a3" name="BlockingQueue&lt;E>">
              <templateBinding xmi:id="2f76c3b1-4626-40e7-9bd5-e61b4d856769" signature="3df8a56c-a69e-47a6-b9ba-5b7ad2b010d1">
                <parameterSubstitution xmi:id="7cf4b38c-2101-438e-9d1f-d3a053cac768" formal="ec3c5e56-2684-4450-a723-b7b565f5dc58" actual="8f65d0a2-e835-47b1-8469-aded8828f317"/>
              </templateBinding>
