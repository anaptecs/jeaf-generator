                <nestedClassifier xmi:type="uml:Class" xmi:id="252e831b-227d-4f97-bc49-24a7d210152f" name="ComboBoxLayoutManager" clientDependency="9b665f91-e64a-4c6a-8a81-bb4eb70af465">
                  <ownedComment xmi:id="c250899f-7182-4b4a-badd-d858bb72bc80" body="This layout manager handles the 'standard' layout of combo boxes.  It puts&#xA;the arrow button to the right and the editor to the left.  If there is no&#xA;editor it still keeps the arrow button to the right.&#xA;&#xA;This public inner class should be treated as protected.&#xA;Instantiate it only within subclasses of&#xA;&lt;code>BasicComboBoxUI&lt;/code>.&#xA;" annotatedElement="252e831b-227d-4f97-bc49-24a7d210152f"/>
