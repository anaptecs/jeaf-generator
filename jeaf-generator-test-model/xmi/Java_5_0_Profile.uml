            <packagedElement xmi:type="uml:Interface" xmi:id="5d98403e-a4c4-42fe-88ba-ad2ed07b8e18" name="LightweightPeer" isAbstract="true">
              <ownedComment xmi:id="089ea6c4-c5ae-48d6-8584-e6ad06a300ec" body="The LightweightPeer interface marks a component as depending upon&#xA;a native container so window related events can be routed to the&#xA;component.  Since this only applies to components and their&#xA;extensions, this interface extends ComponentPeer.&#xA;&lt;p>&#xA;The peer interfaces are intended only for use in porting&#xA;the AWT. They are not intended for use by application&#xA;developers, and developers should not implement peers&#xA;nor invoke any of the peer methods directly on the peer&#xA;instances.&#xA;&#xA;@version 1.11 12/19/03&#xA;@author Timothy Prinzing&#xA;" annotatedElement="5d98403e-a4c4-42fe-88ba-ad2ed07b8e18"/>
              <generalization xmi:id="2fc6582c-905d-48a8-bb31-a48e405422b2" isSubstitutable="true" general="14e5b295-1251-40e3-9c5c-1d51d3d77e82"/>
