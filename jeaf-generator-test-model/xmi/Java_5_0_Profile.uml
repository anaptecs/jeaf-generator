            <nestedClassifier xmi:type="uml:Class" xmi:id="d11a306b-fc4f-4b94-b2fd-f2becfebdf7b" name="EmptyEnumerator" visibility="private" clientDependency="b606628e-c18e-41f9-90d5-b5fe59b5a809">
              <ownedComment xmi:id="78654ed8-5308-44ea-bb17-6fbc23a37c7c" body="A hashtable enumerator class for empty hash tables, specializes&#xA;the general Enumerator&#xA;" annotatedElement="d11a306b-fc4f-4b94-b2fd-f2becfebdf7b"/>
