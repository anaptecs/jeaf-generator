            <packagedElement xmi:type="uml:Class" xmi:id="d6777476-210c-4e7d-a681-7ef4c4974821" name="DefaultRGBChooserPanel" visibility="package" clientDependency="5746acaa-9156-407a-9c93-5b8297b3d2c2">
