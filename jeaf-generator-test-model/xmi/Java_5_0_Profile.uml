              <interfaceRealization xmi:id="0ceaac7a-1f94-4667-b9c7-ab3a04bc80f0" name="" supplier="801c09ff-a83d-4bdd-93ab-661c1bcbad05" client="ff445673-d89b-40e6-8687-f39106d40817" contract="801c09ff-a83d-4bdd-93ab-661c1bcbad05"/>
