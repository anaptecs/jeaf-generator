                </nestedClassifier>
                <nestedClassifier xmi:type="uml:Class" xmi:id="0e6fb1d6-8ec4-426e-aae3-f24496211992" name="MenuKeyboardHelper" visibility="private" clientDependency="9ad79d8e-303c-443d-8090-e06d6e0c878d cc69b954-b167-4fd2-b062-89c0fb1d49b0">
                  <ownedComment xmi:id="2ec45170-eb4f-4c96-b867-810639c4e709" body="This helper is added to MenuSelectionManager as a ChangeListener to&#xA;listen to menu selection changes. When a menu is activated, it passes&#xA;focus to its parent JRootPane, and installs an ActionMap/InputMap pair&#xA;on that JRootPane. Those maps are necessary in order for menu&#xA;navigation to work. When menu is being deactivated, it restores focus&#xA;to the component that has had it before menu activation, and uninstalls&#xA;the maps.&#xA;This helper is also installed as a KeyListener on root pane when menu&#xA;is active. It forwards key events to MenuSelectionManager for mnemonic&#xA;keys handling.&#xA;" annotatedElement="0e6fb1d6-8ec4-426e-aae3-f24496211992"/>
                  <interfaceRealization xmi:id="cc69b954-b167-4fd2-b062-89c0fb1d49b0" name="" supplier="334e76ee-f6d5-4094-b3f5-494be7414f2c" client="0e6fb1d6-8ec4-426e-aae3-f24496211992" contract="334e76ee-f6d5-4094-b3f5-494be7414f2c"/>
