          <packagedElement xmi:type="uml:Class" xmi:id="f55648eb-4f84-42f3-85e1-aa0313a4217f" name="HeapIntBufferR" visibility="package">
            <ownedComment xmi:id="117a2f70-ca6a-47f1-8e8a-6b124aae93a7" body="A read-only HeapIntBuffer.  This class extends the corresponding&#xA;read/write class, overriding the mutation methods to throw a {@link&#xA;ReadOnlyBufferException} and overriding the view-buffer methods to return an&#xA;instance of this class rather than of the superclass.&#xA;" annotatedElement="f55648eb-4f84-42f3-85e1-aa0313a4217f"/>
