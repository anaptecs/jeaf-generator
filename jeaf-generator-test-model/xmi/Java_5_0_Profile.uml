          <packagedElement xmi:type="uml:Interface" xmi:id="b858419f-93d0-45dd-8a32-02e73d64d0e8" name="Comparable&lt;Calendar>">
            <templateBinding xmi:id="f5812c4d-3865-463a-8773-b85c3759ff48" signature="5ad198c9-2870-4ea9-8c7f-1eac95f41aa9">
