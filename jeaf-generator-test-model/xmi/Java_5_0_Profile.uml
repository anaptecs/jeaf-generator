            </nestedClassifier>
            <nestedClassifier xmi:type="uml:Class" xmi:id="61a49430-74b3-4e9d-9975-24a8c744ca5c" name="TreeModelHandler" visibility="protected" clientDependency="f5d75bd9-2e02-4d70-bb67-b222cad44c5f">
              <ownedComment xmi:id="eeb3b6f8-3616-456b-b553-f2fdb77f8c5c" body="Listens to the model and updates the &lt;code>expandedState&lt;/code>&#xA;accordingly when nodes are removed, or changed.&#xA;" annotatedElement="61a49430-74b3-4e9d-9975-24a8c744ca5c"/>
              <interfaceRealization xmi:id="f5d75bd9-2e02-4d70-bb67-b222cad44c5f" name="" supplier="926679b4-597b-4f14-95c3-4956e7352241" client="61a49430-74b3-4e9d-9975-24a8c744ca5c" contract="926679b4-597b-4f14-95c3-4956e7352241"/>
            </nestedClassifier>
            <nestedClassifier xmi:type="uml:Class" xmi:id="f6feda0c-225c-4937-b4b5-c545049c8835" name="DynamicUtilTreeNode">
              <ownedComment xmi:id="a6459e95-bd66-4167-a302-6e34739199cd" body="&lt;code>DynamicUtilTreeNode&lt;/code> can wrap&#xA;vectors/hashtables/arrays/strings and&#xA;create the appropriate children tree nodes as necessary. It is&#xA;dynamic in that it will only create the children as necessary.&#xA;&lt;p>&#xA;&lt;strong>Warning:&lt;/strong>&#xA;Serialized objects of this class will not be compatible with&#xA;future Swing releases. The current serialization support is&#xA;appropriate for short term storage or RMI between applications running&#xA;the same version of Swing.  As of 1.4, support for long term storage&#xA;of all JavaBeans&lt;sup>&lt;font size=&quot;-2&quot;>TM&lt;/font>&lt;/sup>&#xA;has been added to the &lt;code>java.beans&lt;/code> package.&#xA;Please see {@link java.beans.XMLEncoder}.&#xA;" annotatedElement="f6feda0c-225c-4937-b4b5-c545049c8835"/>
              <generalization xmi:id="93a76530-67e6-4f51-be1b-4125f9fddc72" isSubstitutable="true" general="6dc229cb-94f7-487a-91eb-a329de143f38"/>
            </nestedClassifier>
            <nestedClassifier xmi:type="uml:Class" xmi:id="5fb655b2-86c0-40d1-b687-2459de8e98b6" name="AccessibleJTree" visibility="protected" clientDependency="2ef110e2-6f39-4cca-adc8-bc45cac1354a 444f5742-1b27-4ca9-98c5-d43db5569c67 492a9076-fbcd-413f-80a4-92255d251c62 836b2332-beca-4cda-92c2-9f4315be054a">
              <ownedComment xmi:id="aeac0719-e858-49f9-ae1c-338aea3fff6f" body="This class implements accessibility support for the&#xA;&lt;code>JTree&lt;/code> class.  It provides an implementation of the&#xA;Java Accessibility API appropriate to tree user-interface elements.&#xA;&lt;p>&#xA;&lt;strong>Warning:&lt;/strong>&#xA;Serialized objects of this class will not be compatible with&#xA;future Swing releases. The current serialization support is&#xA;appropriate for short term storage or RMI between applications running&#xA;the same version of Swing.  As of 1.4, support for long term storage&#xA;of all JavaBeans&lt;sup>&lt;font size=&quot;-2&quot;>TM&lt;/font>&lt;/sup>&#xA;has been added to the &lt;code>java.beans&lt;/code> package.&#xA;Please see {@link java.beans.XMLEncoder}.&#xA;" annotatedElement="5fb655b2-86c0-40d1-b687-2459de8e98b6"/>
              <generalization xmi:id="91d9ceb5-27a0-4909-ba84-f73f31d7026a" isSubstitutable="true" general="7476a5d9-16dc-482c-bb13-90f59bc1c7b6"/>
