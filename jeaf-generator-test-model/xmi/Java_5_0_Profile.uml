                <parameterSubstitution xmi:id="1ecd23f0-d6d5-40e3-b992-cd2ad9e00e65" formal="7b16f894-dca4-4787-b2f9-4a01749f8a12" actual="6e16dbee-010f-4cc1-a091-a6a0310dcd56"/>
              </templateBinding>
            </packagedElement>
            <packagedElement xmi:type="uml:Class" xmi:id="ee758153-f931-43ca-bcea-40b9d95c713b" name="AbstractList&lt;E>">
              <templateBinding xmi:id="b53282db-9ffe-43c6-81e4-c6faec33d918" signature="644f38f8-9f74-4a51-b690-c537f6da35cc">
                <parameterSubstitution xmi:id="2b145b71-21c6-4e6c-bb16-e316e865c35f" formal="23b58bd8-95d6-4436-97e9-b49cfc2bf205" actual="6098a001-385c-47e1-a848-deacecbab243"/>
