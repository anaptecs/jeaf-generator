          <packagedElement xmi:type="uml:Class" xmi:id="9a68774c-cc71-4bf8-b4ba-125848842abb" name="StackOverflowError">
            <ownedComment xmi:id="98c25811-edb2-4d2f-b2b0-4450b19d88ef" body="Thrown when a stack overflow occurs because an application&#xA;recurses too deeply.&#xA;&#xA;@author unascribed&#xA;@version 1.21, 12/19/03&#xA;@since   JDK1.0&#xA;" annotatedElement="9a68774c-cc71-4bf8-b4ba-125848842abb"/>
