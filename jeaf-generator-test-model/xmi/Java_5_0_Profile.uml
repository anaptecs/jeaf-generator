              <nestedClassifier xmi:type="uml:Class" xmi:id="4f3edeaa-a742-447a-9d89-6edae46c2f91" name="AccessibleAWTListChild" visibility="protected" clientDependency="f8bf1581-72a1-4e2b-bd2f-e07d816b15d5">
