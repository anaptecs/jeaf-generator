              <nestedClassifier xmi:type="uml:Class" xmi:id="886d3559-d4a6-48b6-895b-8ee35a4d8655" name="UIResourceTableCellRenderer" visibility="private" clientDependency="3d1524cc-1251-4112-be02-edce69811a42">
                <generalization xmi:id="507991b0-7f0b-4045-a0cb-5d2b905c2b3c" isSubstitutable="true" general="b5b4054c-1a18-45b2-9a45-50414a92e4ea"/>
