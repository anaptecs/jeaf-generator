              <packagedElement xmi:type="uml:Class" xmi:id="cda62f84-aa12-4f2e-9c0a-b817cadb6b8f" name="SynthPasswordFieldUI" visibility="package">
                <ownedComment xmi:id="4671ba14-500b-4fb3-ab85-0630348a2b9d" body="Provides the Synth look and feel for a password field.&#xA;The only difference from the standard text field is that&#xA;the view of the text is simply a string of the echo&#xA;character as specified in JPasswordField, rather than the&#xA;real text contained in the field.&#xA;&#xA;@author  Shannon Hickey&#xA;@version 1.7 03/19/04&#xA;" annotatedElement="cda62f84-aa12-4f2e-9c0a-b817cadb6b8f"/>
