                <ownedComment xmi:id="115f2236-61e1-4109-8751-9f89cf2fc26c" body="Case independent unicode (including supplementary characters) value.&#xA;" annotatedElement="9c34a569-75f9-49e2-b5d5-ed6357c45e74"/>
                <generalization xmi:id="3e09c6eb-2709-4f68-8bef-1f6e4d7f2593" isSubstitutable="true" general="e7901300-aa23-4b2f-88de-866200abe660"/>
              </nestedClassifier>
              <nestedClassifier xmi:type="uml:Class" xmi:id="dd4fded9-0777-4c54-9c1f-5fb1f6238256" name="NotSingleU" visibility="package" isLeaf="true">
                <ownedComment xmi:id="248191be-d26a-45e7-9ed6-b5a32b13182b" body="Case independent unicode value.&#xA;" annotatedElement="dd4fded9-0777-4c54-9c1f-5fb1f6238256"/>
                <generalization xmi:id="012b6e1f-fb49-485a-a679-597835d82cde" isSubstitutable="true" general="e7901300-aa23-4b2f-88de-866200abe660"/>
