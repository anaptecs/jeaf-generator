              </ownedParameter>
            </ownedTemplateSignature>
            <generalization xmi:id="8ff29cac-eb8c-4a13-a624-ac767183a73c" isSubstitutable="true" general="ec29d9fd-f66a-4a01-a246-04b974e8c332"/>
            <interfaceRealization xmi:id="4eff86af-d672-4d19-bbe2-3571b9ffeb9e" name="" supplier="18dc6102-a040-4ae1-aefe-698abc18de28" client="ee9266be-eae0-49e8-91fe-4a43bd0a984e" contract="18dc6102-a040-4ae1-aefe-698abc18de28"/>
            <nestedClassifier xmi:type="uml:Class" xmi:id="99239a4b-3065-4cdf-bdaf-8c410591c74d" name="Itr" visibility="private" clientDependency="27dbcafc-b672-4dae-b0e5-fc141269d22d">
              <interfaceRealization xmi:id="27dbcafc-b672-4dae-b0e5-fc141269d22d" name="" supplier="d1e63ecf-6944-4b2b-bb25-31ddeaff2a6f" client="99239a4b-3065-4cdf-bdaf-8c410591c74d" contract="d1e63ecf-6944-4b2b-bb25-31ddeaff2a6f"/>
