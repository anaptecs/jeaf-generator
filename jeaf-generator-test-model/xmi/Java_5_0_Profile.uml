          <packagedElement xmi:type="uml:Class" xmi:id="1622d866-591b-4a08-ace2-ed7c4952a6a0" name="MBeanFeatureInfo" clientDependency="89c0bf4c-5348-4004-8ed9-abb3515b69ad">
            <ownedComment xmi:id="860213f5-9873-4b3f-ad8d-bd3d941b5a8c" body="&lt;p>Provides general information for an MBean descriptor object.&#xA;The feature described can be an attribute, an operation, a&#xA;parameter, or a notification.  Instances of this class are&#xA;immutable.  Subclasses may be mutable but this is not&#xA;recommended.&lt;/p>&#xA;&#xA;@since 1.5&#xA;" annotatedElement="1622d866-591b-4a08-ace2-ed7c4952a6a0"/>
            <interfaceRealization xmi:id="89c0bf4c-5348-4004-8ed9-abb3515b69ad" name="" supplier="56bf6aa5-263a-4a52-8bf0-175f4238b77e" client="1622d866-591b-4a08-ace2-ed7c4952a6a0" contract="56bf6aa5-263a-4a52-8bf0-175f4238b77e"/>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="1d9eaf7a-1c6a-4bb6-a03a-0516b4ad8426" name="BadStringOperationException">
            <ownedComment xmi:id="229df102-0594-49af-a4b9-66bd073cdf4b" body="Thrown when an invalid string operation is passed&#xA;to a method for constructing a query.&#xA;&#xA;@since 1.5&#xA;" annotatedElement="1d9eaf7a-1c6a-4bb6-a03a-0516b4ad8426"/>
