          <packagedElement xmi:type="uml:Class" xmi:id="98411b27-4371-4ec2-bc44-d88236f06e02" name="EnumMapIterator&lt;V>">
            <templateBinding xmi:id="087fae52-3a0c-4043-9135-77c237549f9a" signature="150e524f-7dee-4b7d-b793-886a51284c29">
              <parameterSubstitution xmi:id="825c78ed-c51d-4ce1-80cb-f59e452186f8" formal="fc0ff6cd-6d3d-4473-bce8-82bf97987257" actual="26b6c8b6-c70e-48b5-84d1-02f0bbef16c1"/>
