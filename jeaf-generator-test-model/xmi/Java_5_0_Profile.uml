          <packagedElement xmi:type="uml:Class" xmi:id="61401072-ad4f-4546-9e3c-8e5d2f20a933" name="ParseException">
            <ownedComment xmi:id="bae1c04a-697b-40a4-b55b-097765a7055d" body="Signals that an error has been reached unexpectedly&#xA;while parsing.&#xA;@see java.lang.Exception&#xA;@see java.text.Format&#xA;@see java.text.FieldPosition&#xA;@version     1.16, 12/19/03&#xA;@author      Mark Davis&#xA;" annotatedElement="61401072-ad4f-4546-9e3c-8e5d2f20a933"/>
