              </ownedParameter>
            </ownedTemplateSignature>
            <generalization xmi:id="0efda9ea-facb-4a8b-b64f-c035a7e1fef0" isSubstitutable="true" general="32039b30-5f37-4895-b302-b6075d436dab"/>
            <interfaceRealization xmi:id="af820ef5-10ae-4c12-bc38-f35ad8619b09" name="" supplier="baa392ca-bff3-4d7d-b407-489a8610c855" client="55e177f2-b717-41f7-a367-e36173d2bcae" contract="baa392ca-bff3-4d7d-b407-489a8610c855"/>
            <interfaceRealization xmi:id="5c32ea55-4719-444c-88db-0cff95d450f7" name="" supplier="2221a66a-f41d-45b3-9bf0-09796b003ada" client="55e177f2-b717-41f7-a367-e36173d2bcae" contract="2221a66a-f41d-45b3-9bf0-09796b003ada"/>
