                <ownedComment xmi:id="63503430-49ff-453f-a1a8-72b80325c5d9" body="protected final subclass that encapsulates an iterator but implements&#xA;a noop remove() method.&#xA;" annotatedElement="38e63bc4-5200-47f9-afbc-071d6dc9c35e"/>
