          <packagedElement xmi:type="uml:Interface" xmi:id="821822d6-26f9-42d9-b968-5777759c14d8" name="Iterator&lt;String>">
            <templateBinding xmi:id="65b5650c-e230-4a7f-a0ca-0496911a9b2c" signature="0f8c6981-4608-4e07-a119-f77e4e17cb2d">
              <parameterSubstitution xmi:id="1b6d036f-2f10-4e13-a023-5d814ac12782" formal="3b71f5d7-d328-40b6-8dcc-6484e179fd5e" actual="44c739ae-2460-4446-b06e-bab4190d37f4"/>
