                    <ownedParameteredElement xmi:type="uml:Class" xmi:id="e9c8137a-3ba8-4321-971c-f72a7bcf6a38" name="K" templateParameter="c2551e08-c36d-4de3-8a3a-a2a46695a369"/>
                  </ownedParameter>
