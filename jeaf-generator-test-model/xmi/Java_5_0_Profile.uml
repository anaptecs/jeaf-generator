          <packagedElement xmi:type="uml:Class" xmi:id="b66a573b-6db5-46ce-b320-426c81bdfc7b" name="LegacyLayoutFocusTraversalPolicy" visibility="package" isLeaf="true">
            <generalization xmi:id="e6116302-7679-4d85-b13c-e04bb6deeaf8" isSubstitutable="true" general="0c2caf13-98bc-4937-b949-800fd142c2ed"/>
