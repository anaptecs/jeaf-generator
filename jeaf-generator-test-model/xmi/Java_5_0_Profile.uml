          <packagedElement xmi:type="uml:Class" xmi:id="87a9b261-4ddf-4477-9e3b-891c7f380357" name="TimerThread" visibility="package">
            <ownedComment xmi:id="7e72f7c4-72cb-41b8-b58e-1a3faeced5f4" body="This &quot;helper class&quot; implements the timer's task execution thread, which&#xA;waits for tasks on the timer queue, executions them when they fire,&#xA;reschedules repeating tasks, and removes cancelled tasks and spent&#xA;non-repeating tasks from the queue.&#xA;" annotatedElement="87a9b261-4ddf-4477-9e3b-891c7f380357"/>
            <generalization xmi:id="7d573b55-175e-46aa-adba-23a660172b8b" isSubstitutable="true" general="c9830202-c9c4-48c6-a18c-376520128934"/>
          </packagedElement>
