                <interfaceRealization xmi:id="20094078-a256-4f1d-a12e-692d8a6d9d80" name="" supplier="f13859ab-f5c7-4e32-aec4-d277f0b50022" client="4e8c8952-cd18-4226-bceb-4d94759c1c82" contract="f13859ab-f5c7-4e32-aec4-d277f0b50022"/>
