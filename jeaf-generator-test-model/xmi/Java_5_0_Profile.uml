          <packagedElement xmi:type="uml:Class" xmi:id="f7346c90-fee3-443d-92c0-6e4a5b8a5ba8" name="AbstractSequentialList&lt;E>">
            <templateBinding xmi:id="3dbabec3-932e-4ff5-b754-2c915d3f2c4f" signature="853617a7-536b-40e5-9f86-cef924471c47">
