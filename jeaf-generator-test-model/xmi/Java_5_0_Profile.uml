              <ownedComment xmi:id="e85fd288-7ffc-41ce-91ae-c6cba14b005f" body="This class implements a stream filter for writing compressed data in&#xA;the GZIP file format.&#xA;@version &#x9;1.22, 12/19/03&#xA;@author &#x9;David Connelly&#xA;&#xA;" annotatedElement="0ee562cf-a17b-4c02-acd8-57a8de33c7b6"/>
