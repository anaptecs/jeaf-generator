          <packagedElement xmi:type="uml:Class" xmi:id="8564352d-0c0a-4453-90df-0731d2b6dcbc" name="AbstractStringBuilder" visibility="package" clientDependency="cb58ecf0-2e54-4aa4-80d4-c50540433ea8 50788d53-f00c-4c0d-9f6a-56fffa802648" isAbstract="true">
            <ownedComment xmi:id="2f9594f0-c9cb-4d5d-9f60-34c6a7d6c9d2" body="A mutable sequence of characters.&#xA;&lt;p>&#xA;Implements a modifiable string. At any point in time it contains some&#xA;particular sequence of characters, but the length and content of the&#xA;sequence can be changed through certain method calls.&#xA;&#xA;@author&#x9;Michael McCloskey&#xA;@version &#x9;1.12, 07/16/04&#xA;@since&#x9;1.5&#xA;" annotatedElement="8564352d-0c0a-4453-90df-0731d2b6dcbc"/>
            <interfaceRealization xmi:id="cb58ecf0-2e54-4aa4-80d4-c50540433ea8" name="" supplier="e1b0e7ce-3e7f-4c85-be61-5b3588027acb" client="8564352d-0c0a-4453-90df-0731d2b6dcbc" contract="e1b0e7ce-3e7f-4c85-be61-5b3588027acb"/>
