          <packagedElement xmi:type="uml:Class" xmi:id="e5d62208-ef13-4e3f-9e5a-9483f3cd3cc1" name="CompareTabOrderComparator" visibility="package" clientDependency="b68d2a67-fa89-4648-a66b-a3def5547d56" isLeaf="true">
