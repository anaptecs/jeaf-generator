                <nestedClassifier xmi:type="uml:Class" xmi:id="6dce273c-65ef-4c73-a22f-79f5ea229be3" name="ListMouseMotionHandler" visibility="protected">
                  <ownedComment xmi:id="7435a4c7-0b84-4ba6-a675-3d0c5ddeeaaf" body="This listener changes the selected item as you move the mouse over the list.&#xA;The selection change is not committed to the model, this is for user feedback only.&#xA;" annotatedElement="6dce273c-65ef-4c73-a22f-79f5ea229be3"/>
