              <generalization xmi:id="77e5f428-7309-45b6-8640-f382008f39dc" isSubstitutable="true" general="7aeba934-44c6-42f4-9082-79695a7c74c4"/>
              <interfaceRealization xmi:id="b3b07804-928e-46c6-b81e-1ecfa303c693" name="" supplier="a2cdda80-53a0-4729-afe1-d6a5b85b6ecc" client="5f71545f-eb1c-4908-8ba9-c90ef39c1682" contract="a2cdda80-53a0-4729-afe1-d6a5b85b6ecc"/>
