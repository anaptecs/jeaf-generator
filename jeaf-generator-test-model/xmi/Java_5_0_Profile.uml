          <packagedElement xmi:type="uml:Class" xmi:id="876503e0-55ec-4d2e-ad43-a5bae3d7d7b5" name="XMLUtils" visibility="package">
            <ownedComment xmi:id="d42cb66c-deca-4ff8-b01d-6082f3963378" body="A class used to aid in Properties load and save in XML. Keeping this&#xA;code outside of Properties helps reduce the number of classes loaded&#xA;when Properties is loaded.&#xA;&#xA;@version 1.9, 01/23/03&#xA;@author  Michael McCloskey&#xA;@since   1.3&#xA;" annotatedElement="876503e0-55ec-4d2e-ad43-a5bae3d7d7b5"/>
