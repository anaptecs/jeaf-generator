            <nestedClassifier xmi:type="uml:Class" xmi:id="374b80d6-3605-4163-b5b3-a99dc1564520" name="ListItr" visibility="private" clientDependency="9b1442d9-1668-409f-83c0-8dafd4f66eec">
              <generalization xmi:id="3e50b0ab-4f9e-42e4-a413-49739b294a0f" isSubstitutable="true" general="99239a4b-3065-4cdf-bdaf-8c410591c74d"/>
              <interfaceRealization xmi:id="9b1442d9-1668-409f-83c0-8dafd4f66eec" name="" supplier="125391a5-cf0a-4304-bc13-9acf146357ed" client="374b80d6-3605-4163-b5b3-a99dc1564520" contract="125391a5-cf0a-4304-bc13-9acf146357ed"/>
