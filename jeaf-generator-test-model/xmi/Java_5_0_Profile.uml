              <packagedElement xmi:type="uml:Class" xmi:id="8fcd3a35-6590-40e0-86c7-e77182f11346" name="AtomicReferenceArray" clientDependency="abf13a45-ae40-4810-ad97-0986d1a29bbd">
                <ownedComment xmi:id="21caca67-44b7-4028-abe7-f1e98aa11e6e" body="An array of object references in which elements may be updated&#xA;atomically.  See the {@link java.util.concurrent.atomic} package&#xA;specification for description of the properties of atomic&#xA;variables.&#xA;@since 1.5&#xA;@author Doug Lea&#xA;@param &lt;E> The base class of elements held in this array&#xA;" annotatedElement="8fcd3a35-6590-40e0-86c7-e77182f11346"/>
