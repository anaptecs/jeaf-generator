            <packagedElement xmi:type="uml:Class" xmi:id="4e52fe80-110b-4651-b623-ba5879c96543" name="FutureTask&lt;V>">
              <templateBinding xmi:id="6cc1a336-56e0-41f3-832f-aaf6bb2e354d" signature="382cfab0-5411-4580-8f52-bf4536e774e4">
