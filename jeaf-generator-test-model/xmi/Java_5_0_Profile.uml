          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="d38c0f24-c7ba-44a1-a3a9-248882c28927" name="ByteBufferAsDoubleBufferRB" visibility="package">
            <generalization xmi:id="1029deef-f384-4bac-989c-f3f8a17f0ed0" isSubstitutable="true" general="4ade080d-9783-4329-8876-023c390e544f"/>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="e089ebd5-aaa3-44f4-b8a1-246b0a078776" name="HeapDoubleBufferR" visibility="package">
            <ownedComment xmi:id="652a9afc-2c68-48cf-851f-819fde9680eb" body="A read-only HeapDoubleBuffer.  This class extends the corresponding&#xA;read/write class, overriding the mutation methods to throw a {@link&#xA;ReadOnlyBufferException} and overriding the view-buffer methods to return an&#xA;instance of this class rather than of the superclass.&#xA;" annotatedElement="e089ebd5-aaa3-44f4-b8a1-246b0a078776"/>
            <generalization xmi:id="7e657157-951c-4118-bdb7-6d545be55ca8" isSubstitutable="true" general="f12e55fb-76c4-4f27-9a26-13690b93fb11"/>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="c31b73ef-8200-4307-885c-09b6ba2b2c45" name="DirectCharBufferRS" visibility="package">
            <generalization xmi:id="522f3273-94da-4ef8-9b63-8952e999d4a9" isSubstitutable="true" general="f07282c6-8547-468f-a871-908371a25218"/>
          </packagedElement>
          <packagedElement xmi:type="uml:Interface" xmi:id="e19f688e-e409-439c-9fc4-2e2752ed890c" name="Comparable&lt;CharBuffer>">
            <templateBinding xmi:id="23d372b8-dda7-4708-ad06-e01f751dfbf0" signature="5ad198c9-2870-4ea9-8c7f-1eac95f41aa9">
