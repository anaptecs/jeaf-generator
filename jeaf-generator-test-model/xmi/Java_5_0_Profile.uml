            </nestedClassifier>
          </packagedElement>
          <packagedElement xmi:type="uml:Class" xmi:id="ef8b5e69-9567-4164-8dde-503b0e38ae0c" name="ColorTracker" visibility="package" clientDependency="110d0245-794a-42c3-80b3-9b9e141fa50b dd919f96-77c1-444a-a699-636456a3d69f">
            <interfaceRealization xmi:id="110d0245-794a-42c3-80b3-9b9e141fa50b" name="" supplier="881e1f63-ea05-4933-82ba-17d8d70f9be1" client="ef8b5e69-9567-4164-8dde-503b0e38ae0c" contract="881e1f63-ea05-4933-82ba-17d8d70f9be1"/>
