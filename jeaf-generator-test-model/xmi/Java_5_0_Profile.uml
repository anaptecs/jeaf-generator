              </ownedParameter>
            </ownedTemplateSignature>
            <generalization xmi:id="81cde08a-3624-4a33-8edc-c686daca4266" isSubstitutable="true" general="f7346c90-fee3-443d-92c0-6e4a5b8a5ba8"/>
