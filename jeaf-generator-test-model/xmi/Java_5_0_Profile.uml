            </nestedClassifier>
            <nestedClassifier xmi:type="uml:Class" xmi:id="33eab649-1512-4591-9121-e4d301adb9f5" name="EntryIterator" visibility="private" clientDependency="cccc7d3a-8525-4f1b-9692-092f0784f71a">
