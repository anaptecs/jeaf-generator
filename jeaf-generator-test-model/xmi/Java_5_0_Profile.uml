                <ownedComment xmi:id="dd0dd121-4814-40d0-bff8-31831230bb2a" body="An implementation of &lt;code>AttributeSet&lt;/code> that can multiplex&#xA;across a set of &lt;code>AttributeSet&lt;/code>s.&#xA;&#xA;@version 1.4 12/19/03&#xA;" annotatedElement="aae0753f-f196-417c-9843-7eecf1b4d946"/>
                <interfaceRealization xmi:id="95d04870-0fef-4715-b3f3-380a4f13e84d" name="" supplier="dff5659c-62af-4166-9a96-573a58fd7f7e" client="aae0753f-f196-417c-9843-7eecf1b4d946" contract="dff5659c-62af-4166-9a96-573a58fd7f7e"/>
