              <nestedClassifier xmi:type="uml:Class" xmi:id="9878ddc3-7238-4617-ae85-a63b9c78c4ca" name="StyleChangeUndoableEdit" visibility="package">
                <ownedComment xmi:id="01a1313f-7ebe-4dd1-935a-1cc32064df78" body="UndoableEdit for changing the resolve parent of an Element.&#xA;" annotatedElement="9878ddc3-7238-4617-ae85-a63b9c78c4ca"/>
