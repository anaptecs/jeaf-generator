              <parameterSubstitution xmi:id="d5f7b6f5-fdb6-4580-a738-0b1b53b7f5e4" formal="e7a6699c-c87d-47b5-a068-dc2f3a0244ad" actual="f6b64015-bccd-491f-9f7d-8237a8f83387"/>
            </templateBinding>
          </packagedElement>
          <packagedElement xmi:type="uml:Package" xmi:id="ef9ebd4d-3533-4d19-990e-7b51fd973a8a" name="ref">
            <packagedElement xmi:type="uml:Class" xmi:id="81ff3790-dad8-4625-8537-6156aaab4fd9" name="ReferenceQueue">
              <ownedComment xmi:id="2369a3ff-dc50-4212-a18f-051e2b6d95b6" body="Reference queues, to which registered reference objects are appended by the&#xA;garbage collector after the appropriate reachability changes are detected.&#xA;&#xA;@version  1.23, 12/19/03&#xA;@author   Mark Reinhold&#xA;@since    1.2&#xA;" annotatedElement="81ff3790-dad8-4625-8537-6156aaab4fd9"/>
              <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="aebec65e-6f41-4516-b9af-2e53882fd036" name="" parameter="9749c541-59ed-4a3e-b570-e8236c9ed9f9">
                <ownedParameter xmi:type="uml:ClassifierTemplateParameter" xmi:id="9749c541-59ed-4a3e-b570-e8236c9ed9f9" parameteredElement="625279bf-289b-4e0a-99cf-5621f559ab9e">
