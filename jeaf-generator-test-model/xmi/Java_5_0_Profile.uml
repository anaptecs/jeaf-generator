            <packagedElement xmi:type="uml:Class" xmi:id="afa76432-8672-4dec-8c5e-0fb70a51e22e" name="DelayQueue" clientDependency="8da11309-4f0c-41de-8a01-fb75d4dc0926">
              <ownedComment xmi:id="85478c7b-5530-4632-87f8-3ae1fc5d986e" body="An unbounded {@linkplain BlockingQueue blocking queue} of&#xA;&lt;tt>Delayed&lt;/tt> elements, in which an element can only be taken&#xA;when its delay has expired.  The &lt;em>head&lt;/em> of the queue is that&#xA;&lt;tt>Delayed&lt;/tt> element whose delay expired furthest in the&#xA;past. If no delay has expired there is no head and &lt;tt>poll&lt;/tt>&#xA;will return &lt;tt>null&lt;/tt>. Expiration occurs when an element's&#xA;&lt;tt>getDelay(TimeUnit.NANOSECONDS)&lt;/tt> method returns a value less&#xA;than or equal to zero.  This queue does not permit &lt;tt>null&lt;/tt>&#xA;elements.&#xA;&#xA;&lt;p>This class and its iterator implement all of the&#xA;&lt;em>optional&lt;/em> methods of the {@link Collection} and {@link&#xA;Iterator} interfaces.&#xA;&#xA;&lt;p>This class is a member of the&#xA;&lt;a href=&quot;{@docRoot}/../guide/collections/index.html&quot;>&#xA;Java Collections Framework&lt;/a>.&#xA;&#xA;@since 1.5&#xA;@author Doug Lea&#xA;@param &lt;E> the type of elements held in this collection&#xA;" annotatedElement="afa76432-8672-4dec-8c5e-0fb70a51e22e"/>
              <ownedTemplateSignature xmi:type="uml:RedefinableTemplateSignature" xmi:id="ba8acdd9-b1df-4e05-ac3c-e8d072aff9a1" name="" parameter="18e4f519-d090-4286-90c1-36089bf05827">
                <ownedParameter xmi:type="uml:ClassifierTemplateParameter" xmi:id="18e4f519-d090-4286-90c1-36089bf05827" parameteredElement="7e164047-c330-4014-9c13-0b9aba4bf103">
                  <ownedParameteredElement xmi:type="uml:Class" xmi:id="7e164047-c330-4014-9c13-0b9aba4bf103" name="E" clientDependency="fbd02db7-305e-4b4f-bf7b-9ce6cf679931" templateParameter="18e4f519-d090-4286-90c1-36089bf05827">
