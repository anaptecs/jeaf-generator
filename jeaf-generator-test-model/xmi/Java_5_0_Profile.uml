              <packagedElement xmi:type="uml:Class" xmi:id="b6038ff3-cf1d-465d-9e64-8ca72904a03e" name="MetalComboBoxIcon" clientDependency="cc999be6-5a3e-40fd-9592-b138d95d6350 69fff867-d32f-4b1e-873a-fcdda551854b">
                <ownedComment xmi:id="20898b89-4ae0-42b8-af94-77e61b24b847" body="This utility class draws the horizontal bars which indicate a MetalComboBox&#xA;&#xA;@see MetalComboBoxUI&#xA;@version 1.13 12/19/03&#xA;@author Tom Santos&#xA;" annotatedElement="b6038ff3-cf1d-465d-9e64-8ca72904a03e"/>
