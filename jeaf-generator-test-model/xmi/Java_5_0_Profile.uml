          <packagedElement xmi:type="uml:Class" xmi:id="2639dd2a-3908-4215-811d-05d8d3e44453" name="AncestorNotifier" visibility="package" clientDependency="f4b1c855-75fe-4167-8964-b68b02b0fccc 0584cd39-e5c1-4c4e-9b03-9550e190ca3c 2b0e47b5-34e9-4245-b60e-d0ce81b79a78">
            <ownedComment xmi:id="2da2b5fc-dcd8-406e-b75c-acaa7efbb79c" body="@version 1.19 12/19/03&#xA;@author Dave Moore&#xA;" annotatedElement="2639dd2a-3908-4215-811d-05d8d3e44453"/>
