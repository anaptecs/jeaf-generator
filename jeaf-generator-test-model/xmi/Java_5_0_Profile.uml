              </ownedParameter>
            </ownedTemplateSignature>
            <generalization xmi:id="7b0c2b72-4ab6-4074-9fce-e06786596a86" isSubstitutable="true" general="57267948-5b20-4000-a393-c9fc60c633c3"/>
