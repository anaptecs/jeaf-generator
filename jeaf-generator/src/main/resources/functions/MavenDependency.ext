extension java::GeneratorCommons;
extension functions::SystemProperties;
extension functions::NamedElement;
extension functions::Javadoc;

cached boolean isMavenDependency(uml::Element element) :
	element.isStereotypeApplied("MavenDependency");

cached JMM::MavenDependency asMavenDependency(uml::Element element):
	(JMM::MavenDependency) element;


cached isParentPOMDependency(JMM::MavenDependency dependency):
	dependency.dependencyType.name == "PARENT_POM";

cached isProjectDependency(JMM::MavenDependency dependency):
	dependency.dependencyType.name == "PROJECT_DEPENDENCY";

cached isStandardDependency(JMM::MavenDependency dependency):
	dependency.dependencyType.name == "STANDARD_DEPENDENCY";

