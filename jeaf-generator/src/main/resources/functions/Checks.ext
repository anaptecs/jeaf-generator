extension java::GeneratorCommons;
extension functions::SystemProperties;
extension functions::Class;
extension functions::Enumeration;
extension functions::Property;
extension functions::NamedElement;
extension functions::Parameter;
extension functions::Operation;


cached boolean runNonMandatoryChecks(uml::NamedElement element):
	runNonMandatoryChecks(element, "", "");


cached boolean runNonMandatoryChecks(uml::NamedElement element, String checkCode):
	runNonMandatoryChecks(element, checkCode, "");


cached boolean runNonMandatoryChecks(uml::NamedElement element, String checkCode, String stereotype):
	if disableAllNonMandatoryChecks()
	then false
	else
		if element.isExcludedFromNonMandatoryChecks(checkCode)
		then false
		else runChecks(element, stereotype);


private cached isExcludedFromNonMandatoryChecks(uml::NamedElement element, String checkCode):
	if element.getExclusionElementName().length > 0
	then element.getExclusionElementName().isExcludedFromCheck(checkCode)
	else false;

cached getExclusionElementName(uml::NamedElement element):
	if element.isClass() || element.isEnumeration()
	then element.qualifiedName()
	else if element.isProperty()
	then (element.owner.asNamedElement().qualifiedName() + "." + element.name)
	else if element.isParameter()
	then (element.owner.asNamedElement().qualifiedName() + "()." + element.name)
	else if element.isOperation()
	then element.qualifiedName() + "()"
	else "";


private cached boolean isExcludedFromCheck(String pModelElementName, String pCheckCode):
	JAVA com.anaptecs.jeaf.fwk.generator.checks.CheckExclusionCache.isExcluded(java.lang.String, java.lang.String);


