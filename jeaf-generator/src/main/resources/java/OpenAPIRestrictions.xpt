«IMPORT uml»
«IMPORT JMM»

«EXTENSION java::CustomValidationCommons»
«EXTENSION java::OpenAPIFunctions»
«EXTENSION java::GeneratorCommons»

«EXTENSION functions::Property»
«EXTENSION functions::Validation»
«EXTENSION functions::NamedElement»
«EXTENSION functions::MultiplicityElement»
«EXTENSION functions::Parameter»
«EXTENSION functions::Dependency»

«EXTENSION org::openarchitectureware::util::stdlib::io»


«DEFINE OpenAPIRestrictions(String indent) FOR MultiplicityElement -»
    «LET this.getAllIndirectValidationStereotypeNames() AS allIndirectValidationStereotypeNames -»
    «LET this.getEffectiveDirectValidationStereotyeNames() AS effectiveDirectValidationStereotyeNames -»
	«FOREACH effectiveDirectValidationStereotyeNames AS stereotypeName -»
            «EXPAND GenerateOpenAPIValidationRestriction(stereotypeName.toString(), indent) FOR this.asNamedElement() -»
	«ENDFOREACH -»
    «FOREACH allIndirectValidationStereotypeNames AS stereotypeName -»
            «EXPAND GenerateOpenAPIValidationRestriction(stereotypeName, indent) FOREACH this.asNamedElement().getValidationDependenciesForOpenAPI() -»
	«ENDFOREACH -»
	«IF this.isMultivalued() -»
		«IF (this.isProperty() && this.asProperty().type.isByteType()) || (this.isParameter() && this.asParameter().type.isByteType()) -»
		«ELSE-»
		«IF allIndirectValidationStereotypeNames.contains("Size") -»
			«LET this.asNamedElement().getValidationDependenciesForOpenAPI().selectFirst(e|e.isStereotypeApplied("Size")).getStereotypeValue("Size", "min") AS minSize -»
				«IF minSize.length > 0 && minSize.asInteger() > 0 -»
«indent»      minItems: «minSize»
				«ENDIF -»
			«ENDLET -»
			«LET this.asNamedElement().getValidationDependenciesForOpenAPI().selectFirst(e|e.isStereotypeApplied("Size")).getStereotypeValue("Size", "max") AS maxSize -»
				«IF maxSize.length > 0 && maxSize.asInteger() > 0 -»
«indent»      maxItems: «maxSize»
				«ENDIF -»
			«ENDLET -»
		«ELSEIF allIndirectValidationStereotypeNames.contains("Optional") -»«REM»No special handling required as minItems = 0 is the default in OpenAPI«ENDREM»
		«ELSEIF effectiveDirectValidationStereotyeNames.contains("Size") -»
			«LET maxValue(this.asNamedElement().getStereotypeValue("Size", "min").asInteger(), this.lower) AS minSize -»
				«IF minSize > 0 -»
«indent»      minItems: «minSize»
				«ENDIF -»
			«ENDLET -»
			«LET this.asNamedElement().getStereotypeValue("Size", "max") AS maxSize -»
				«IF maxSize.length > 0 && maxSize.asInteger() > 0 -»
«indent»      maxItems: «maxSize»
				«ENDIF -»
			«ENDLET -»
		«ELSEIF this.lower > 0 -»
«indent»      minItems: «this.lower»
		«ENDIF -»
		«ENDIF -»
	«ENDIF -»
    «ENDLET -»
    «ENDLET -»
«ENDDEFINE»


«DEFINE GenerateOpenAPIValidationRestriction(String stereotypeName, String indent) FOR NamedElement -»
		«IF this.isStereotypeApplied(stereotypeName) -»
			«IF stereotypeName == "DecimalMin" -»
			  «EXPAND DecimalMinAnnotation(indent) FOR ((DecimalMin)this)»
			«ELSEIF stereotypeName == "DecimalMax" -»
			  «EXPAND DecimalMaxAnnotation(indent) FOR ((DecimalMax)this)»
			«ELSEIF stereotypeName == "Min" -»
			  «EXPAND MinValueAnnotation(indent) FOR ((Min)this)»
			«ELSEIF stereotypeName == "Max" -»
			  «EXPAND MaxValueAnnotation(indent) FOR ((Max)this)»
			«ELSEIF stereotypeName == "Negative" -»
			  «EXPAND NegativeAnnotation(indent) FOR this.asNamedElement()»
			«ELSEIF stereotypeName == "NegativeOrZero" -»
			  «EXPAND NegativeOrZeroAnnotation(indent) FOR this.asNamedElement()»
			«ELSEIF stereotypeName == "PositiveOrZero" -»
			  «EXPAND PositiveOrZeroAnnotation(indent) FOR this.asNamedElement()»
			«ELSEIF stereotypeName == "Positive" -»
			  «EXPAND PositiveAnnotation(indent) FOR this.asNamedElement()»
			«ELSEIF stereotypeName == "Size" -»
			  «IF (this.isMultiplicityElement() && this.asMultiplicityElement().isMultivalued() == false) || (this.isDependency() && this.asDependency().source.first().isMultiplicityElement() && this.asDependency().source.first().asMultiplicityElement().isMultivalued() == false) || (this.isProperty() && this.asProperty().type.isByteType() &&  this.asProperty().isMultivalued())  || (this.isParameter() && this.asParameter().type.isByteType() && this.asParameter().type.isByteType()) -»
			  «EXPAND LengthAnnotation(indent) FOR ((Size) this)»
			  «ENDIF -»
			«ELSEIF stereotypeName == "NotEmpty" -»
			  «IF (this.isMultiplicityElement() && this.asMultiplicityElement().isMultivalued() == false) || (this.isDependency() && this.asDependency().source.first().isMultiplicityElement() && this.asDependency().source.first().asMultiplicityElement().isMultivalued() == false) -»
			  «EXPAND NotEmptyStringAnnotation(indent) FOR ((NotEmpty) this) -»
			  «ELSE -»
			  «EXPAND NotEmptyArrayAnnotation(indent) FOR ((NotEmpty) this) -»
			  «ENDIF -»
			«ELSEIF stereotypeName == "NotBlank" -»
			  «EXPAND NotBlankAnnotation(indent) FOR this.asNamedElement() -»
			«ELSE -»
			«ENDIF -»
		«ENDIF -»
«ENDDEFINE»


«DEFINE DecimalMinAnnotation(String indent) FOR DecimalMin -»
«IF isOpenAPIVersion30() -»
«indent»      minimum: «this.minValue»
«indent»      exclusiveMinimum: «!this.inclusive -»
«ELSE -»
«IF inclusive -»
«indent»      minimum: «this.minValue»«ELSE -»
«indent»      exclusiveMinimum: «this.minValue -»
«ENDIF -»
«ENDIF -»
«ENDDEFINE»


«DEFINE DecimalMaxAnnotation(String indent) FOR DecimalMax -»
«IF isOpenAPIVersion30() -»
«indent»      maximum: «this.maxValue»
«indent»      exclusiveMaximum: «!this.inclusive -»
«ELSE -»
«IF inclusive -»
«indent»      maximum: «this.maxValue»«ELSE -»
«indent»      exclusiveMaximum: «this.maxValue -»
«ENDIF -»
«ENDIF -»
«ENDDEFINE»


«DEFINE MinValueAnnotation(String indent) FOR Min-»
«indent»      minimum: «this.minValue -»
«ENDDEFINE»


«DEFINE MaxValueAnnotation(String indent) FOR Max -»
«indent»      maximum: «this.maxValue -»
«ENDDEFINE»


«DEFINE NegativeAnnotation(String indent) FOR NamedElement -»
«IF isOpenAPIVersion30() -»
«indent»      maximum: 0
«indent»      exclusiveMaximum: true«ELSE -»
«indent»      exclusiveMaximum: 0«ENDIF -»«ENDDEFINE»


«DEFINE NegativeOrZeroAnnotation(String indent) FOR NamedElement -»
«indent»      maximum: 0«ENDDEFINE»


«DEFINE PositiveOrZeroAnnotation(String indent) FOR NamedElement -»
«indent»      minimum: 0«ENDDEFINE»


«DEFINE PositiveAnnotation(String indent) FOR NamedElement -»
«IF isOpenAPIVersion30() -»
«indent»      minimum: 0
«indent»      exclusiveMinimum: true«ELSE -»
«indent»      exclusiveMinimum: 0«ENDIF -»«ENDDEFINE»


«DEFINE LengthAnnotation(String indent) FOR Size -»
          «IF min != -1 && max != -1 -»
«indent»      minLength: «min»
«indent»      maxLength: «max»«ELSE-»
              «IF min != -1-»
«indent»      minLength: «min»«ELSE -»
                  «IF max != -1 -»
«indent»      maxLength: «max»«ENDIF -»«ENDIF-»«ENDIF-»«ENDDEFINE»


«DEFINE NotEmptyStringAnnotation(String indent) FOR NotEmpty -»
«indent»      minLength: 1
«ENDDEFINE»


«DEFINE NotEmptyArrayAnnotation(String indent) FOR NotEmpty -»
«indent»      minItems: 1
«ENDDEFINE»


«DEFINE NotBlankAnnotation(String indent) FOR NamedElement -»
«indent»      minLength: 1
«ENDDEFINE»
