			«ENDLET»
		«ENDIF»
		«FOREACH validationDependencies AS depdendency»
			«LET (Positive) depdendency AS positiveAnnotation»
			@«getEnterpriseJavaPackage()».validation.constraints.Positive(«IF positiveAnnotation.hasErrorCodeOrSeverity()»«EXPAND ValidationAnnotationBasicsEmptyValidation FOR positiveAnnotation», «ENDIF»«EXPAND ValidationGroupsSection FOR depdendency.getValidationGroups()»)
			«ENDLET»
		«ENDFOREACH»
