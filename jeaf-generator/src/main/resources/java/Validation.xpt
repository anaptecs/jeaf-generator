«IMPORT uml»
«IMPORT JMM»
«EXTENSION java::Naming»
«EXTENSION java::GeneratorCommons»
«EXTENSION java::CustomValidationCommons»
«EXTENSION functions::Validation»
«EXTENSION functions::Property»
«EXTENSION functions::Parameter»
«EXTENSION functions::Dependency»
«EXTENSION functions::NamedElement»
«EXTENSION functions::SystemProperties»
«EXTENSION org::openarchitectureware::util::stdlib::io»

«DEFINE GenerateCustomValidation FOR CustomConstraint»
	«info("Processing «CustomConstraint» " + this.name + " (" + (this.fqn()) + ")")»
	«LET className.split("\\.").last() AS validationClass»
	«LET className.replaceFirst("\\."+validationClass, "") AS packageName»
	«info("Validation Class: " + validationClass)»
	«FILE className.packagePath() + ".java" src_gen»
package «packageName»;

import static java.lang.annotation.ElementType.ANNOTATION_TYPE;
import static java.lang.annotation.ElementType.FIELD;
import static java.lang.annotation.ElementType.METHOD;
import static java.lang.annotation.ElementType.PARAMETER;
import static java.lang.annotation.ElementType.TYPE_USE;
import static java.lang.annotation.RetentionPolicy.RUNTIME;

import java.lang.annotation.Retention;
import java.lang.annotation.Target;

import «getEnterpriseJavaPackage()».validation.Constraint;
import «getEnterpriseJavaPackage()».validation.Payload;


@Target({ FIELD, METHOD, PARAMETER, ANNOTATION_TYPE, TYPE_USE })
@Retention(RUNTIME)
@Constraint(validatedBy = {«FOREACH validatedBy AS validatorClass SEPARATOR ', '»«validatorClass».class «ENDFOREACH»})
public @interface «validationClass» {
    «FOREACH this.ownedAttribute AS attribute»
	    «IF attribute.name.startsWith("base_") == false»
			«attribute.fqn()» «attribute.name»() 
			«IF attribute.defaultValue.isNull() == false-»
				default
			    «REM»Annotation supports either primitive types or enums.«ENDREM»
			    «IF attribute.isMultivalued()»{«ENDIF-»
			    «IF attribute.type.isPrimitiveType()-»
			    	«attribute.defaultValue.stringValue()-»
			    «ELSE-»
			    	«attribute.type.fqn()».«attribute.defaultValue.stringValue()-»
			    «ENDIF-»
			    «IF attribute.isMultivalued()»}«ENDIF-»
			«ENDIF-»;
	    «ENDIF-»
    «ENDFOREACH-»
	String message() default "{«className».message}";

	Class<?>[] groups() default { };

	Class<? extends Payload>[] payload() default { };
}
	«ENDFILE»
	«ENDLET»«ENDLET»	
«ENDDEFINE»

«DEFINE ValidationAnnotation FOR NamedElement»
	«EXPAND ValidationAnnotation(null)»
«ENDDEFINE»


«DEFINE ValidationAnnotation(String parameterContext) FOR NamedElement»
    «LET this.getAllDirectValidationStereotypes() AS allDirectValidationStereotypes»
	
    «LET this.getAllIndirectValidationStereotypes() AS allIndirectValidationStereotypes»
    «LET this.getRemoveValidationDependencies() AS removeValidationDepedencies»
	
	«LET {}.addAll(allDirectValidationStereotypes).addAll(allIndirectValidationStereotypes) AS allValidationStereotypes»
	«LET allValidationStereotypes.typeSelect(Stereotype).name.toSet() AS allValidationStereotypeNames»

    «FOREACH allValidationStereotypeNames AS stereotypeName»
    	«LET allDirectValidationStereotypes.select(e|e.name == stereotypeName).first() AS directValidationStereotype»
    	«LET allIndirectValidationStereotypes.select(e|e.name == stereotypeName) AS indirectValidationStereotypes»
	    «LET this.clientDependency.select(e|e.target.typeSelect(JMM::CompatibilityGroup).isEmpty == false && e.getAppliedStereotypes().select(e|e.name == stereotypeName).isEmpty == false) AS validationDependencies»
	    
	    «LET removeValidationDepedencies.select(e|e.getStereotypeValue("RemoveValidation", "removedValidations").contains(stereotypeName)).getValidationGroups() AS removeValidationGroups»
	    «LET removeValidationGroups.isEmpty == false || validationDependencies.isEmpty == false AS hasValidationGroups»
	    
	    «LET (List[JMM::ValidationGroup]) getModel().getAllValidationGroupsFromModel().removeAll(validationDependencies.getValidationGroups()).removeAll(removeValidationGroups) AS defaultValidationGroups»
	    
			«IF stereotypeName == "DecimalMin"»
			  «EXPAND DecimalMinAnnotation(directValidationStereotype, validationDependencies, defaultValidationGroups, hasValidationGroups) FOR this»
	
			«ELSEIF stereotypeName == "DecimalMax"»
			  «EXPAND DecimalMaxAnnotation(directValidationStereotype, validationDependencies, defaultValidationGroups, hasValidationGroups) FOR this»	
	
			«ELSEIF stereotypeName == "Min"»
			  «EXPAND MinAnnotation(directValidationStereotype, validationDependencies, defaultValidationGroups, hasValidationGroups) FOR this»	
			
			«ELSEIF stereotypeName == "Max"»
			  «EXPAND MaxAnnotation(directValidationStereotype, validationDependencies, defaultValidationGroups, hasValidationGroups) FOR this»
	
			«ELSEIF stereotypeName == "Digits"»
			  «EXPAND DigitsAnnotation(directValidationStereotype, validationDependencies, defaultValidationGroups, hasValidationGroups) FOR this»
	
			«ELSEIF stereotypeName == "Negative"»
			  «EXPAND NegativeAnnotation(directValidationStereotype, validationDependencies, defaultValidationGroups, hasValidationGroups) FOR this»
	
			«ELSEIF stereotypeName == "NegativeOrZero"»
			  «EXPAND NegativeOrZeroAnnotation(directValidationStereotype, validationDependencies, defaultValidationGroups, hasValidationGroups) FOR this»
	
			«ELSEIF stereotypeName == "PositiveOrZero"»
			  «EXPAND PositiveOrZeroAnnotation(directValidationStereotype, validationDependencies, defaultValidationGroups, hasValidationGroups) FOR this»
	
			«ELSEIF stereotypeName == "Positive"»
			  «EXPAND PositiveAnnotation(directValidationStereotype, validationDependencies, defaultValidationGroups, hasValidationGroups) FOR this»
	
			«ELSEIF stereotypeName == "Size"»
			  «EXPAND SizeAnnotation(directValidationStereotype, validationDependencies, defaultValidationGroups, hasValidationGroups) FOR this»
	
			«ELSEIF stereotypeName == "Pattern"»
			  «EXPAND PatternAnnotation(directValidationStereotype, validationDependencies, defaultValidationGroups, hasValidationGroups) FOR this»
	
			«ELSEIF stereotypeName == "Email"»
			  «EXPAND EmailAnnotation(directValidationStereotype, validationDependencies, defaultValidationGroups, hasValidationGroups) FOR this»
	
			«ELSEIF stereotypeName == "NotEmpty"»
			  «EXPAND NotEmptyAnnotation(directValidationStereotype, validationDependencies, defaultValidationGroups, hasValidationGroups) FOR this»
	
			«ELSEIF stereotypeName == "Null"»
			  «EXPAND NullAnnotation(directValidationStereotype, validationDependencies, defaultValidationGroups, hasValidationGroups) FOR this»
	
			«ELSEIF stereotypeName == "NotNull"»
			  «EXPAND NotNullAnnotation(directValidationStereotype, validationDependencies, defaultValidationGroups, hasValidationGroups) FOR this»
	
			«ELSEIF stereotypeName == "AssertTrue"»
			  «EXPAND AssertTrueAnnotation(directValidationStereotype, validationDependencies, defaultValidationGroups, hasValidationGroups) FOR this»
	
			«ELSEIF stereotypeName == "AssertFalse"»
			  «EXPAND AssertFalseAnnotation(directValidationStereotype, validationDependencies, defaultValidationGroups, hasValidationGroups) FOR this»
	
			«ELSEIF stereotypeName == "NotBlank"»
			  «EXPAND NotBlankAnnotation(directValidationStereotype, validationDependencies, defaultValidationGroups, hasValidationGroups) FOR this»
	
			«ELSEIF stereotypeName == "Past"»
			  «EXPAND PastAnnotation(directValidationStereotype, validationDependencies, defaultValidationGroups, hasValidationGroups) FOR this»
	
			«ELSEIF stereotypeName == "PastOrPresent"»
			  «EXPAND PastOrPresentAnnotation(directValidationStereotype, validationDependencies, defaultValidationGroups, hasValidationGroups) FOR this»
	
			«ELSEIF stereotypeName == "FutureOrPresent"»
			  «EXPAND FutureOrPresentAnnotation(directValidationStereotype, validationDependencies, defaultValidationGroups, hasValidationGroups) FOR this»
	
			«ELSEIF stereotypeName == "Future"»
			  «EXPAND FutureAnnotation(directValidationStereotype, validationDependencies, defaultValidationGroups, hasValidationGroups) FOR this»
	
			«ELSEIF stereotypeName == "Valid" -»
			  «EXPAND ValidAnnotation FOR ((Valid) this) -»
			
			«ELSEIF stereotypeName == "Optional"»
				«REM»
					This case is handled in other areas already and is only there to avoid to end up in general ELSE section
				«ENDREM»
			«ELSE»
			  «EXPAND CustomValidationAnnotation(directValidationStereotype)»
			«ENDIF»
		«ENDLET»
		«ENDLET»
		«ENDLET»
		«ENDLET»
		«ENDLET»
		«ENDLET»
	«ENDFOREACH»
		«LET this.clientDependency.select(e|e.target.typeSelect(JMM::CompatibilityGroup).isEmpty == false && e.getAppliedStereotypes().select(e|e.isValidationStereotype() && e.name == "Optional").isEmpty == false) AS optionalValidationDependencies»
		«LET (List[JMM::ValidationGroup]) this.getModel().getAllValidationGroupsFromModel().removeAll(optionalValidationDependencies.getValidationGroups()) AS leftOverGroups»
			«IF this.isProperty()»
				«LET this.asProperty() AS property»
					«IF property.association == null»
						«IF generateValidationAnnotationsForAttributesFromMultiplicity() && property.isStatic == false && property.isTransient() == false && property.isMultivalued() == true && allValidationStereotypeNames.contains("Size") == false && property.lower() > 0»
							«IF optionalValidationDependencies.isEmpty»
								@«getEnterpriseJavaPackage()».validation.constraints.Size(min = «property.lower()»)
							«ELSE»
								@«getEnterpriseJavaPackage()».validation.constraints.Size(min = «property.lower()», «EXPAND ValidationGroupsSection FOR leftOverGroups»)
							«ENDIF»
						«ENDIF»
						«IF generateValidationAnnotationsForAttributesFromMultiplicity() && property.isStatic == false && property.isTransient() == false && property.isMultivalued() == false && property.type.isPrimitiveType() == false && allValidationStereotypeNames.contains("NotNull") == false && this.requiresNotNullAnnotation() && property.lower() > 0»
							«IF optionalValidationDependencies.isEmpty»
								@«getEnterpriseJavaPackage()».validation.constraints.NotNull
							«ELSE»
								@«getEnterpriseJavaPackage()».validation.constraints.NotNull(«EXPAND ValidationGroupsSection FOR leftOverGroups»)
							«ENDIF»
						«ENDIF»
					«ELSE»
						«IF generateValidationAnnotationsForAssociationsFromMultiplicity() && property.isMultivalued() && property.isStatic == false && property.isTransient() == false && allValidationStereotypeNames.contains("Size") == false && property.lower() > 0»
							«IF optionalValidationDependencies.isEmpty»
								@«getEnterpriseJavaPackage()».validation.constraints.Size(min = «property.lower()»)
							«ELSE»
								@«getEnterpriseJavaPackage()».validation.constraints.Size(min = «property.lower()», «EXPAND ValidationGroupsSection FOR leftOverGroups»)
							«ENDIF»
						«ENDIF»
						«IF generateValidationAnnotationsForAssociationsFromMultiplicity() && property.isStatic == false && property.isTransient() == false && allValidationStereotypeNames.contains("NotNull") == false && this.requiresNotNullAnnotation() && property.lower() > 0»
							«IF optionalValidationDependencies.isEmpty»
								@«getEnterpriseJavaPackage()».validation.constraints.NotNull
							«ELSE»
								@«getEnterpriseJavaPackage()».validation.constraints.NotNull(«EXPAND ValidationGroupsSection FOR leftOverGroups»)
							«ENDIF»
						«ENDIF»
					«ENDIF»
				«ENDLET»
			«ELSEIF this.isParameter() && generateValidationAnnotationForParam(parameterContext)»
				«LET (Parameter) this AS parameter»
					«IF parameter.isMultivalued()»
						«IF optionalValidationDependencies.isEmpty && allValidationStereotypeNames.contains("Size") == false && parameter.lowerForParam() > 0»
							@«getEnterpriseJavaPackage()».validation.constraints.Size(min = «parameter.lowerForParam()»)
						«ELSE»
							@«getEnterpriseJavaPackage()».validation.constraints.Size(min = «parameter.lowerForParam()», «EXPAND ValidationGroupsSection FOR leftOverGroups»)
						«ENDIF»
					«ELSEIF parameter.type.isPrimitiveType() == false»
						«IF optionalValidationDependencies.isEmpty && allValidationStereotypeNames.contains("NotNull") == false && parameter.lowerForParam() > 0»
							@«getEnterpriseJavaPackage()».validation.constraints.NotNull
						«ELSE»
							@«getEnterpriseJavaPackage()».validation.constraints.NotNull(«EXPAND ValidationGroupsSection FOR leftOverGroups»)
						«ENDIF»
					«ENDIF»
				«ENDLET»
			«ENDIF»
		«ENDLET»
		«ENDLET»
	«IF this.isStereotypeApplied("Valid") == false»
		«IF generateValidAnnotationsForClasses() &&(this.isStereotypeApplied("POJO") || this.isStereotypeApplied("ServiceObject") || this.isStereotypeApplied("DomainObject") || this.isStereotypeApplied("PersistentObject"))»
		@«getEnterpriseJavaPackage()».validation.Valid
		«ENDIF»
	    «IF generateValidAnnotationsForAssociations() && this.isProperty() && (this.asProperty().type.isStereotypeApplied("POJO") || this.asProperty().type.isStereotypeApplied("ServiceObject") || this.asProperty().type.isStereotypeApplied("DomainObject") || this.asProperty().type.isStereotypeApplied("PersistentObject") || this.asProperty().type.isTemplateParameter())»
	    @«getEnterpriseJavaPackage()».validation.Valid
	    «ENDIF»
    «ENDIF»
    «ENDLET»
    «ENDLET»
    «ENDLET»
    «ENDLET»
    «ENDLET»
«ENDDEFINE»


«DEFINE DecimalMinAnnotation(Stereotype directValidationStereotype, List[Dependency] validationDependencies, List[JMM::ValidationGroup] defaultValidationGroups, boolean hasValidationGroups) FOR NamedElement»
	«REM»No validation groups needed (= only direct validation and no indirect validation stereotypes)«ENDREM»
	«IF directValidationStereotype != null && hasValidationGroups == false»
		«LET (DecimalMin) this AS decimalMinAnnotation»
		@«getEnterpriseJavaPackage()».validation.constraints.DecimalMin(value = "«decimalMinAnnotation.minValue»", inclusive = «decimalMinAnnotation.inclusive» «EXPAND ValidationAnnotationBasics FOR decimalMinAnnotation»)
		«ENDLET»
	«REM»Resolve validation groups for which the validation should be applied«ENDREM»
	«ELSE»
		«IF directValidationStereotype != null && defaultValidationGroups.isEmpty == false»
			«LET (DecimalMin) this AS decimalMinAnnotation»
			@«getEnterpriseJavaPackage()».validation.constraints.DecimalMin(value = "«decimalMinAnnotation.minValue»", inclusive = «decimalMinAnnotation.inclusive» «EXPAND ValidationAnnotationBasics FOR decimalMinAnnotation», «EXPAND ValidationGroupsSection FOR defaultValidationGroups»)
			«ENDLET»
		«ENDIF»
		«FOREACH validationDependencies AS depdendency»
			«LET (DecimalMin) depdendency AS decimalMinAnnotation»
			@«getEnterpriseJavaPackage()».validation.constraints.DecimalMin(value = "«decimalMinAnnotation.minValue»", inclusive = «decimalMinAnnotation.inclusive» «EXPAND ValidationAnnotationBasics FOR decimalMinAnnotation», «EXPAND ValidationGroupsSection FOR depdendency.getValidationGroups()»)
			«ENDLET»
		«ENDFOREACH»
	«ENDIF»
«ENDDEFINE»


«DEFINE DecimalMaxAnnotation(Stereotype directValidationStereotype, List[Dependency] validationDependencies, List[JMM::ValidationGroup] defaultValidationGroups, boolean hasValidationGroups) FOR NamedElement»
	«REM»No validation groups needed (= only direct validation and no indirect validation stereotypes)«ENDREM»
	«IF directValidationStereotype != null && hasValidationGroups == false»
		«LET (DecimalMax) this AS decimalMaxAnnotation»
		@«getEnterpriseJavaPackage()».validation.constraints.DecimalMax(value = "«decimalMaxAnnotation.maxValue»", inclusive = «decimalMaxAnnotation.inclusive» «EXPAND ValidationAnnotationBasics FOR decimalMaxAnnotation»)
		«ENDLET»
	«REM»Resolve validation groups for which the validation should be applied«ENDREM»
	«ELSE»
		«IF directValidationStereotype != null && defaultValidationGroups.isEmpty == false»
			«LET (DecimalMax) this AS decimalMaxAnnotation»
			@«getEnterpriseJavaPackage()».validation.constraints.DecimalMax(value = "«decimalMaxAnnotation.maxValue»", inclusive = «decimalMaxAnnotation.inclusive» «EXPAND ValidationAnnotationBasics FOR decimalMaxAnnotation», «EXPAND ValidationGroupsSection FOR defaultValidationGroups»)
			«ENDLET»
		«ENDIF»
		«FOREACH validationDependencies AS depdendency»
			«LET (DecimalMax) depdendency AS decimalMaxAnnotation»
			@«getEnterpriseJavaPackage()».validation.constraints.DecimalMax(value = "«decimalMaxAnnotation.maxValue»", inclusive = «decimalMaxAnnotation.inclusive» «EXPAND ValidationAnnotationBasics FOR decimalMaxAnnotation», «EXPAND ValidationGroupsSection FOR depdendency.getValidationGroups()»)
			«ENDLET»
		«ENDFOREACH»
	«ENDIF»
«ENDDEFINE»


«DEFINE MinAnnotation(Stereotype directValidationStereotype, List[Dependency] validationDependencies, List[JMM::ValidationGroup] defaultValidationGroups, boolean hasValidationGroups) FOR NamedElement»
	«REM»No validation groups needed (= only direct validation and no indirect validation stereotypes)«ENDREM»
	«IF directValidationStereotype != null && hasValidationGroups == false»
		«LET (Min) this AS minAnnotation»
		@«getEnterpriseJavaPackage()».validation.constraints.Min(value = «minAnnotation.minValue» «EXPAND ValidationAnnotationBasics FOR minAnnotation»)
		«ENDLET»
	«REM»Resolve validation groups for which the validation should be applied«ENDREM»
	«ELSE»
		«IF directValidationStereotype != null && defaultValidationGroups.isEmpty == false»
			«LET (Min) this AS minAnnotation»
			@«getEnterpriseJavaPackage()».validation.constraints.Min(value = «minAnnotation.minValue» «EXPAND ValidationAnnotationBasics FOR minAnnotation», «EXPAND ValidationGroupsSection FOR defaultValidationGroups»)
			«ENDLET»
		«ENDIF»
		«FOREACH validationDependencies AS depdendency»
			«LET (Min) depdendency AS minAnnotation»
			@«getEnterpriseJavaPackage()».validation.constraints.Min(value = «minAnnotation.minValue» «EXPAND ValidationAnnotationBasics FOR minAnnotation», «EXPAND ValidationGroupsSection FOR depdendency.getValidationGroups()»)
			«ENDLET»
		«ENDFOREACH»
	«ENDIF»
«ENDDEFINE»


