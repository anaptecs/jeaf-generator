	«REM»No validation groups needed (= only direct validation and no indirect validation stereotypes)«ENDREM»
	«IF directValidationStereotype != null && hasValidationGroups == false»
		«LET (Max) this AS maxAnnotation»
		@«getEnterpriseJavaPackage()».validation.constraints.Max(value = «maxAnnotation.maxValue» «EXPAND ValidationAnnotationBasics FOR maxAnnotation»)
