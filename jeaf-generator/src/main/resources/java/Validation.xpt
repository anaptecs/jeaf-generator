«ENDDEFINE»


«DEFINE DigitsAnnotation(Stereotype directValidationStereotype, List[Dependency] validationDependencies, List[JMM::ValidationGroup] defaultValidationGroups, boolean hasValidationGroups) FOR NamedElement»
	«REM»No validation groups needed (= only direct validation and no indirect validation stereotypes)«ENDREM»
	«IF directValidationStereotype != null && hasValidationGroups == false»
		«LET (Digits) this AS digitsAnnotation»
		@«getEnterpriseJavaPackage()».validation.constraints.Digits(integer = «digitsAnnotation.integer», fraction = «digitsAnnotation.fraction» «EXPAND ValidationAnnotationBasics FOR digitsAnnotation»)
		«ENDLET»
	«REM»Resolve validation groups for which the validation should be applied«ENDREM»
	«ELSE»
		«IF directValidationStereotype != null && defaultValidationGroups.isEmpty == false»
			«LET (Digits) this AS digitsAnnotation»
			@«getEnterpriseJavaPackage()».validation.constraints.Digits(integer = «digitsAnnotation.integer», fraction = «digitsAnnotation.fraction» «EXPAND ValidationAnnotationBasics FOR digitsAnnotation», «EXPAND ValidationGroupsSection FOR defaultValidationGroups»)
			«ENDLET»
		«ENDIF»
		«FOREACH validationDependencies AS depdendency»
			«LET (Digits) depdendency AS digitsAnnotation»
			@«getEnterpriseJavaPackage()».validation.constraints.Digits(integer = «digitsAnnotation.integer», fraction = «digitsAnnotation.fraction» «EXPAND ValidationAnnotationBasics FOR digitsAnnotation», «EXPAND ValidationGroupsSection FOR depdendency.getValidationGroups()»)
			«ENDLET»
		«ENDFOREACH»
	«ENDIF»
«ENDDEFINE»


«DEFINE NegativeAnnotation(Stereotype directValidationStereotype, List[Dependency] validationDependencies, List[JMM::ValidationGroup] defaultValidationGroups, boolean hasValidationGroups) FOR NamedElement»
	«REM»No validation groups needed (= only direct validation and no indirect validation stereotypes)«ENDREM»
	«IF directValidationStereotype != null && hasValidationGroups == false»
		«LET (Negative) this AS negativeAnnotation»
		@«getEnterpriseJavaPackage()».validation.constraints.Negative«IF negativeAnnotation.hasErrorCodeOrSeverity()»(«EXPAND ValidationAnnotationBasicsEmptyValidation FOR negativeAnnotation»)«ENDIF»
		«ENDLET»
	«REM»Resolve validation groups for which the validation should be applied«ENDREM»
	«ELSE»
		«IF directValidationStereotype != null && defaultValidationGroups.isEmpty == false»
			«LET (Negative) this AS negativeAnnotation»
			@«getEnterpriseJavaPackage()».validation.constraints.Negative(«IF negativeAnnotation.hasErrorCodeOrSeverity()»«EXPAND ValidationAnnotationBasicsEmptyValidation FOR negativeAnnotation», «ENDIF»«EXPAND ValidationGroupsSection FOR defaultValidationGroups»)
			«ENDLET»
		«ENDIF»
		«FOREACH validationDependencies AS depdendency»
			«LET (Negative) depdendency AS negativeAnnotation»
			@«getEnterpriseJavaPackage()».validation.constraints.Negative(«IF negativeAnnotation.hasErrorCodeOrSeverity()»«EXPAND ValidationAnnotationBasicsEmptyValidation FOR negativeAnnotation», «ENDIF»«EXPAND ValidationGroupsSection FOR depdendency.getValidationGroups()»)
			«ENDLET»
		«ENDFOREACH»
	«ENDIF»
«ENDDEFINE»


