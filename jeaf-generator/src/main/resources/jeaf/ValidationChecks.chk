context NotEmpty if runChecks() && !isDependency() ERROR this.getErrorMessage("9147", {((NamedElement)this.owner).name + "." + name, "NotEmpty"}): type.isCharSequence() || this.isMultivalued();

// Checks for annotation AssertTrue
context AssertTrue if runChecks() && !isDependency() ERROR this.getErrorMessage("9150", {((NamedElement)this.owner).name + "." + name, "AssertTrue"}): type.isBooleanForAnnotation();

// Checks for annotation AssertFalse
context AssertFalse if runChecks()&& !isDependency()  ERROR this.getErrorMessage("9150", {((NamedElement)this.owner).name + "." + name, "AssertFalse"}): type.isBooleanForAnnotation();

// Checks for annotation NotBlank
context NotBlank if runChecks() && !isDependency() ERROR this.getErrorMessage("9138", {((NamedElement)this.owner).name + "." + name, "NotBlank"}): type.isCharSequence();

