import uml;
import JMM;

extension java::GeneratorCommons;
extension functions::Dependency;
extension functions::Validation;
extension functions::NamedElement;
extension functions::Checks;


// Checks for annotation DecimalMin
context DecimalMin if runChecks() && !isDependency() ERROR this.getErrorMessage("9137", {((NamedElement)this.owner).name + "." + name}): minValue.length > 0;
context DecimalMin if runChecks() && !isDependency() ERROR this.getErrorMessage("9138", {((NamedElement)this.owner).name + "." + name, "DecimalMin"}): type.isCharSequence() || type.isNumericForAnnotation();

// Checks for annotation DecimalMax
context DecimalMax if runChecks() && !isDependency() ERROR this.getErrorMessage("9139", {((NamedElement)this.owner).name + "." + name}): maxValue.length > 0;
context DecimalMax if runChecks() && !isDependency() ERROR this.getErrorMessage("9138", {((NamedElement)this.owner).name + "." + name, "DecimalMax"}): type.isCharSequence() || type.isNumericForAnnotation();

// Checks for annotation Min
context Min if runChecks() && !isDependency() ERROR this.getErrorMessage("9140", {((NamedElement)this.owner).name + "." + name, "Min"}): type.isNumericForAnnotation();

