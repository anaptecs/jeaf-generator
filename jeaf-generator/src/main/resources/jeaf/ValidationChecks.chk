// Checks for comaptibility groups
context CompatibilityGroup if runChecks() ERROR  this.getErrorMessage("9187", {name, this.getCompatibilityInfosForGroup().name.toString(", ")}): this.getCompatibilityInfosForGroup().size <= 1;

context EnumSubset if runChecks() ERROR this.getErrorMessage("9189", {name, ((NamedElement)this.owner).qualifiedName()}): !(this.allowedLiterals.size > 0 && this.notAllowedLiterals.size > 0);
context EnumSubset if runChecks() ERROR this.getErrorMessage("9190", {name, ((NamedElement)this.owner).qualifiedName()}): !(this.allowedLiterals.size == 0 && this.notAllowedLiterals.size == 0);
// For dependencies the message refers to the property or parameter, as dependencies are usually unnamed.
context EnumSubset if runChecks() && this.getEnumSubsetTypedElement() != null && this.getEnumSubsetTypedElement().type != null && this.getEnumSubsetTypedElement().isNonMandatoryCheckActive("9210") ERROR this.getEnumSubsetTypedElement().getErrorMessage("9210", {((NamedElement) this.getEnumSubsetTypedElement().owner).name + "." + this.getEnumSubsetTypedElement().name, this.getEnumSubsetTypedElement().type.name}): this.getEnumSubsetTypedElement().hasEnumerationType();

// Checks for validation groups
context ValidationGroup if runChecks() && identifier != null && identifier.length > 0 && this.isNonMandatoryCheckActive("9213") ERROR this.getErrorMessage("9213", {name, identifier, this.getValidationGroupsWithSameIdentifier().qualifiedName().toString(", ")}): this.getValidationGroupsWithSameIdentifier().isEmpty;
// The model itself is not part of the whitelist.
context Model if this.getOpenAPIValidationGroups().select(e|e.runChecks()).isEmpty == false && this.isNonMandatoryCheckActive("9214") ERROR this.getErrorMessage("9214", {this.getOpenAPIValidationGroups().qualifiedName().toString(", ")}): this.getOpenAPIValidationGroups().size <= 1;

// Dependencies are usually unnamed, so the message refers to the client.
context FirstIncompatibleVersion if runChecks() && client.isEmpty == false && ((NamedElement) client.first()).isNonMandatoryCheckActive("9215") WARNING ((NamedElement) client.first()).getWarningMessage("9215", {client.name.toString(", "), supplier.name.toString(", ")}): client.forAll(e|e.isStereotypeApplied("CompatibilityInfo")) && supplier.forAll(e|e.isStereotypeApplied("CompatibilityInfo"));
