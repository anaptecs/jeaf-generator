<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
		<groupId>com.anaptecs.jeaf.generator</groupId>
		<artifactId>jeaf-generator-project</artifactId>
		<version>2.0.1-SNAPSHOT</version>
    </parent>

    <name>JEAF Generator</name>
    <artifactId>jeaf-generator</artifactId>
    <packaging>jar</packaging>

    <properties>
        <jeaf-xpand.version>3.0.0</jeaf-xpand.version>
    </properties>

    <dependencies>
        <!-- Dependency so that message constants generator will also be integrated. -->
        <dependency>
			<groupId>com.anaptecs.jeaf.generator</groupId>
            <artifactId>jeaf-message-constants-generator</artifactId>
            <version>${project.version}</version>
        </dependency>
        
        <dependency>
        	<groupId>com.anaptecs.jeaf.x-fun</groupId>
        	<artifactId>jeaf-x-fun-default-runtime</artifactId>
            <version>${jeaf.x-fun.impl.version}</version>
        	<type>pom</type>
        	<scope>runtime</scope>
        </dependency>

        <!-- Eclipse Xpand / Xtend runtime (JEAF Xpand, based on Eclipse Xpand 2.2.0). MWE and ANTLR are transitive dependencies. -->
        <dependency>
            <groupId>com.anaptecs.jeaf.xpand</groupId>
            <artifactId>xtend</artifactId>
            <version>${jeaf-xpand.version}</version>
        </dependency>
        <dependency>
            <groupId>com.anaptecs.jeaf.xpand</groupId>
            <artifactId>xpand</artifactId>
            <version>${jeaf-xpand.version}</version>
        </dependency>
        <dependency>
            <groupId>com.anaptecs.jeaf.xpand</groupId>
            <artifactId>xtend-typesystem-emf</artifactId>
            <version>${jeaf-xpand.version}</version>
        </dependency>
        <dependency>
            <groupId>com.anaptecs.jeaf.xpand</groupId>
            <artifactId>xtend-typesystem-uml2</artifactId>
            <version>${jeaf-xpand.version}</version>
        </dependency>
        <dependency>
            <groupId>com.anaptecs.jeaf.xpand</groupId>
            <artifactId>xtend-util-stdlib</artifactId>
            <version>${jeaf-xpand.version}</version>
        </dependency>

        <dependency>
            <groupId>com.vladsch.flexmark</groupId>
            <artifactId>flexmark-all</artifactId>
            <version>${flexmark.version}</version>
        </dependency>       

		<!-- Apache POI is needed to produce direct reports as *.xlsx. -->
		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi-ooxml</artifactId>
			<version>${apache.poi.version}</version>
		</dependency>
    </dependencies>
</project>