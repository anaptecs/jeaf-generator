	<name>JEAF Generator Other Data Types</name>


	<scm>
		<connection>scm:git:https://github.com/anaptecs/jeaf-generator-other-data-types>.git</connection>
		<developerConnection>scm:git:https://github.com/anaptecs/jeaf-generator-other-data-types>.git</developerConnection>
		<url>https://github.com/anaptecs/jeaf-generator-other-data-types></url>
		<tag>HEAD</tag>
	</scm>


	<properties>
		<!-- Read UML model from Maven artifact. -->
		<modelArtifactGroupID>com.anaptecs.jeaf.uml</modelArtifactGroupID>
		<modelArtifactArtifactID>jeaf-uml-test-model</modelArtifactArtifactID>
		<modelArtifactXMIPath>xmi</modelArtifactXMIPath>

		<!-- Name of the main file with the UML model -->
		<umlModelFile>JEAF_Test.uml</umlModelFile>

