<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>


	<groupId>com.anaptecs.maven</groupId>
	<artifactId>jeaf-generator-other-data-types</artifactId>
	<version>47.1.1</version>

	<packaging>pom</packaging>
	<name>JEAF Generator Other Data Types</name>


	<scm>
		<connection>scm:git:https://github.com/anaptecs/jeaf-generator-other-data-types>.git</connection>
		<developerConnection>scm:git:https://github.com/anaptecs/jeaf-generator-other-data-types>.git</developerConnection>
		<url>https://github.com/anaptecs/jeaf-generator-other-data-types></url>
		<tag>HEAD</tag>
	</scm>


	<properties>
		<!-- Name of the main file with the UML model -->
		<umlModelFile>JEAF_Test.uml</umlModelFile>

		<!-- UML package which will be the one that is considered during code generation --> 
		<umlPackage>com.anaptecs.maven</umlPackage>

	</properties>


	<profiles>
		<profile>
			<id>RunCodeGenerationFromXMIFile</id>
			<properties>
				<!-- PROTECTED REGION ID(local-xmi-directory:com.anaptecs.maven:jeaf-generator-other-data-types) ENABLED START -->
				<!--
					TODO: Please define from where the UML model should be read, either directly from the local file system
					or from a Maven artifact that contains the so called XMI files.
				-->
				<!-- Read UML model (XMI files) directly from local file system -->
				<xmiDirectory>TODO</xmiDirectory>
				<!-- PROTECTED REGION END -->
			</properties>
		</profile>
		<profile>
			<id>RunCodeGenerationFromModelArtifact</id>
			<properties>
				<!-- Read UML model from Maven artifact. -->
				<modelArtifactGroupID>com.anaptecs.jeaf.uml</modelArtifactGroupID>
				<modelArtifactArtifactID>jeaf-uml-test-model</modelArtifactArtifactID>
				<modelArtifactXMIPath>xmi</modelArtifactXMIPath>
			</properties>
		</profile>
	</profiles>


	<modules>
		<module>jeaf-generator-other-data-types-bom</module>
		<module>jeaf-generator-other-data-types-uml</module>
		<module>jeaf-generator-other-data-types-open-api</module>
		<module>jeaf-generator-other-data-types-java</module>
		<module>jeaf-generator-other-data-types-java-runtime</module>
		<module>jeaf-generator-other-data-types-starter</module>
		<module>jeaf-generator-other-data-types-integration-test</module>
	</modules>


	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.anaptecs.maven</groupId>
				<artifactId>jeaf-generator-other-data-types-uml</artifactId>
				<version>47.1.1</version>
			</dependency>
			<dependency>
				<groupId>com.anaptecs.maven</groupId>
				<artifactId>jeaf-generator-other-data-types-open-api</artifactId>
				<version>47.1.1</version>
			</dependency>
			<dependency>
				<groupId>com.anaptecs.maven</groupId>
				<artifactId>jeaf-generator-other-data-types-java</artifactId>
				<version>47.1.1</version>
			</dependency>
			<dependency>
				<groupId>com.anaptecs.maven</groupId>
				<artifactId>jeaf-generator-other-data-types-java-runtime</artifactId>
				<version>47.1.1</version>
			</dependency>
			<dependency>
				<groupId>com.anaptecs.maven</groupId>
				<artifactId>jeaf-generator-other-data-types-starter</artifactId>
				<version>47.1.1</version>
			</dependency>
		</dependencies>
	</dependencyManagement>


	<dependencies>
